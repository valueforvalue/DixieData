package templates

import (
	"fmt"
	"net/url"
	"path/filepath"
	"regexp"
	"strings"
	"time"

	"github.com/valueforvalue/DixieData/internal/dates"
	"github.com/valueforvalue/DixieData/internal/htmxattr"
	"github.com/valueforvalue/DixieData/internal/models"
	"github.com/valueforvalue/DixieData/internal/persondisplay"
	"github.com/valueforvalue/DixieData/internal/records"
	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/uiids"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ SoldierCard(s viewmodel.PersonRecord, highlighted bool) {
		<div class={ soldierCardClass(highlighted) }>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
				<span class="gold text-xs font-semibold uppercase tracking-[0.2em]">{ s.DisplayID }</span>
				<p class="mt-1 font-semibold text-slate-900">{ detailHeading(s) }</p>
				if detailSubheadingIsMaidenName(s) {
					<p class="text-sm text-slate-500"><em>{ detailSubheading(s) }</em></p>
				} else {
					<p class="text-sm text-slate-500">{ detailSubheading(s) }</p>
				}
				if s.NeedsReview {
					<div class="mt-2 flex flex-wrap gap-2 text-xs">
						<span class="rounded-full border border-[rgb(var(--theme-review-red-rgb)/0.45)] bg-[rgb(var(--theme-review-red-rgb)/0.12)] px-2.5 py-1 font-semibold uppercase tracking-[0.18em] text-[var(--theme-review-red)]">Needs Review</span>
						if strings.TrimSpace(s.ReviewReason) != "" {
							<span class="rounded-full border border-[rgb(var(--theme-review-red-rgb)/0.2)] bg-[rgba(255,241,239,0.88)] px-2.5 py-1 text-[var(--theme-review-red)]">{ s.ReviewReason }</span>
						}

					</div>
				}
				if strings.TrimSpace(s.SearchMatchSnippet) != "" {
					<p class="mt-2 text-xs font-medium text-[var(--theme-review-red)]">Matched on { s.SearchMatchField }: <span class="text-[var(--theme-text-primary)]">{ s.SearchMatchSnippet }</span></p>
				}
				if strings.TrimSpace(s.DeathDate) != "" {
					<p class="text-xs text-slate-400 mt-1">d. { deathDate(s) }</p>
				}
				if highlighted {
					<dl class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
						<div class="inline-flex items-baseline gap-1">
							<dt class="font-semibold uppercase tracking-[0.18em] text-slate-400">Entry</dt>
							<dd>{ entryBadgeLabel(s) }</dd>
						</div>
						if strings.TrimSpace(s.DeathDate) != "" {
							<div class="inline-flex items-baseline gap-1">
								<dt class="font-semibold uppercase tracking-[0.18em] text-slate-400">d.</dt>
								<dd>{ deathDate(s) }</dd>
							</div>
						}
						if strings.TrimSpace(s.BuriedIn) != "" {
							<div class="inline-flex items-baseline gap-1">
								<dt class="font-semibold uppercase tracking-[0.18em] text-slate-400">Buried in</dt>
								<dd>{ s.BuriedIn }</dd>
							</div>
						}
					</dl>
				}
			</div>
			<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d", s.ID)) }
			   class="pill-link self-start sm:self-auto">View Person Record</a>
			</div>
		</div>
}

templ SoldierList(soldiers []viewmodel.PersonRecord, page, total int, query string, suggestions viewmodel.PersonRecordFormSuggestions) {
	@Layout("Soldiers") {
		<div id={ uiids.PageSoldiersList } class="relative">
			<div class="mb-4">
				<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<h2 class="text-2xl gold font-bold">Person Records</h2>
					<a href="/soldiers/new" class="primary-button">+ Add Person Record</a>
				</div>
				<div class="mb-3 grid grid-cols-1 gap-2 sm:flex sm:flex-wrap">
					<button type="button" data-tab-group="soldier-search" data-tab-target="basic" data-tab-default="true"
						class="flex w-full items-center justify-between rounded-xl border border-[var(--theme-accent-strong)] bg-[rgb(var(--theme-parchment-rgb)/0.92)] px-3 py-2 text-sm font-medium text-[var(--theme-text-primary)] transition hover:bg-[rgba(255,247,231,0.98)] sm:w-auto sm:justify-center">
						Quick Search
						
					</button>
					<button type="button" data-tab-group="soldier-search" data-tab-target="advanced"
						class="flex w-full items-center justify-between rounded-xl border border-[var(--theme-accent-strong)] bg-[rgb(var(--theme-parchment-rgb)/0.92)] px-3 py-2 text-sm font-medium text-[var(--theme-text-primary)] transition hover:bg-[rgba(255,247,231,0.98)] sm:w-auto sm:justify-center">
						Advanced Search
						
					</button>
				</div>
				<div id={ uiids.PanelSoldiersSearchBasic } class="contents">
					<div data-tab-panel="soldier-search" data-tab-id="basic" class="relative space-y-2">
					<form { htmxattr.Mux{
						Get:     routebuilder.SoldierSearch(false),
						Target:  "#soldier-list",
						Trigger: "input changed delay:300ms from:input[name='q']",
					}.Attrs()... } hx-sync="this:replace" class="contents">
						<input type="text" placeholder="Search by name, unit, rank, pension state, display ID, or burial place..." name="q"
							value={ query }
							data-quick-search
							class="field-input" aria-label="Quick search across the Local Archive"/>
					</form>
					<div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
						@components.Button("Browse Alphabetically", components.ButtonSecondary, "", htmxattr.Mux{
							Get:    routebuilder.SoldierSearch(true),
							Target: "#soldier-list",
						}.Attrs())
					</div>
					<p class="text-xs text-slate-500">Quick search matches names, relationship labels, units, ranks, pension states, burial locations, and display IDs.</p>
				</div>
				</div>
				<div id={ uiids.PanelSoldiersSearchAdvanced } class="contents">
				<form data-tab-panel="soldier-search" data-tab-id="advanced" class="responsive-two-col relative hidden card rounded-2xl p-5 grid gap-4"
					hx-get={ templ.SafeURL(routebuilder.SoldierSearchAdvanced()) } hx-target="#soldier-list">
					
					<div class="responsive-span-2 col-span-2 rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgb(var(--theme-ink-deep-rgb)/0.06)] px-4 py-3">
						<p class="text-xs font-semibold uppercase tracking-[0.26em] text-[var(--theme-accent-strong)]">Advanced Search Active</p>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-display_id">Display ID</label>
						<input type="text" name="display_id" class="field-input" id="sc-display_id"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-entry_type">Entry Type</label>
						<select name="entry_type" class="field-input" id="sc-entry_type">
							<option value="">All</option>
							<option value={ models.EntryTypeSoldier }>Soldier</option>
							<option value={ models.EntryTypeLinkedPerson }>Person Record</option>
							<option value={ models.EntryTypeWife }>Wife</option>
							<option value={ models.EntryTypeWidow }>Widow</option>
						</select>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-record_type">Source Record Type</label>
						<input type="text" name="record_type" list="advanced-record-type-suggestions" class="field-input" id="sc-record_type"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-first_name">First Name</label>
						<input type="text" name="first_name" class="field-input" id="sc-first_name"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-middle_name">Middle Name</label>
						<input type="text" name="middle_name" class="field-input" id="sc-middle_name"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-last_name">Last Name</label>
						<input type="text" name="last_name" class="field-input" id="sc-last_name"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-maiden_name">Maiden Name</label>
						<input type="text" name="maiden_name" class="field-input" id="sc-maiden_name"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-relationship_label">Relationship to Soldier</label>
						<input type="text" name="relationship_label" list="advanced-relationship-label-suggestions" class="field-input" id="sc-relationship_label"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-rank_in">Rank In</label>
						<input type="text" name="rank_in" list="advanced-rank-in-suggestions" class="field-input" id="sc-rank_in"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-rank_out">Rank Out</label>
						<input type="text" name="rank_out" list="advanced-rank-out-suggestions" class="field-input" id="sc-rank_out"/>
					</div>
					<div class="responsive-span-2 col-span-2">
						<label class="block text-sm text-slate-500 mb-1" for="sc-unit">Unit</label>
						<input type="text" name="unit" list="advanced-unit-suggestions" class="field-input" id="sc-unit"/>
					</div>
					<div class="responsive-span-2 col-span-2">
						<label class="block text-sm text-slate-500 mb-1" for="sc-pension_state">Pension State</label>
						<input type="text" name="pension_state" list="advanced-pension-state-suggestions" class="field-input" placeholder="Any state" id="sc-pension_state"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-confederate_home_status">Confederate Home Status</label>
						<select name="confederate_home_status" class="field-input" id="sc-confederate_home_status">
							<option value="">Any status</option>
							for _, status := range confederateHomeStatuses() {
								<option value={ status }>{ status }</option>
							}
						</select>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-confederate_home_name">Confederate Home Name</label>
						<input type="text" name="confederate_home_name" list="advanced-confederate-home-name-suggestions" class="field-input" id="sc-confederate_home_name"/>
					</div>
					<div class="responsive-span-2 col-span-2">
						<label class="block text-sm text-slate-500 mb-1" for="sc-buried_in">Buried In</label>
						<input type="text" name="buried_in" list="advanced-buried-in-suggestions" class="field-input" id="sc-buried_in"/>
					</div>
					<div class="responsive-span-2 col-span-2">
						<label class="block text-sm text-slate-500 mb-1" for="sc-review_status">Status</label>
						<select name="review_status" class="field-input" id="sc-review_status">
							<option value="">All Person Records</option>
							<option value="clean">Clean Person Records Only</option>
							<option value="review">Review Queue Only</option>
						</select>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-birth_year">Birth Year</label>
						<input type="text" name="birth_year" class="field-input" placeholder="1838" id="sc-birth_year"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-birth_year_to">Birth Year Through</label>
						<input type="text" name="birth_year_to" class="field-input" placeholder="1845" id="sc-birth_year_to"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-death_year">Death Year</label>
						<input type="text" name="death_year" class="field-input" placeholder="1864" id="sc-death_year"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-death_year_to">Death Year Through</label>
						<input type="text" name="death_year_to" class="field-input" placeholder="1865" id="sc-death_year_to"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-birth_date">Birth Date</label>
						<input type="text" name="birth_date" class="field-input" placeholder="MM/DD/YYYY or 11/00/1886" id="sc-birth_date"/>
					</div>
					<div>
						<label class="block text-sm text-slate-500 mb-1" for="sc-death_date">Death Date</label>
						<input type="text" name="death_date" class="field-input" placeholder="MM/DD/YYYY or 11/00/1886" id="sc-death_date"/>
					</div>
					<div class="responsive-span-2 col-span-2 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
						@components.Button("Run Advanced Search", components.ButtonPrimary, "", templ.Attributes{"type": "submit"})
						@components.Button("Reset Filters", components.ButtonGhost, "px-4 py-2", templ.Attributes{"type": "reset"})
					</div>
					<p class="responsive-span-2 col-span-2 text-xs text-slate-500">Advanced search uses <strong>LIKE contains</strong> matching for text fields. Enter one year for an exact match, or add a <strong>Through</strong> year to search a range. Birth and death dates are still <strong>exact</strong> canonical matches using MM/DD/YYYY with 00 for unknown parts.</p>
				</form>
				</div>
				@SuggestionDatalist("advanced-record-type-suggestions", suggestions.SourceRecordType)
				@SuggestionDatalist("advanced-rank-in-suggestions", suggestions.RankIn)
				@SuggestionDatalist("advanced-rank-out-suggestions", suggestions.RankOut)
				@SuggestionDatalist("advanced-unit-suggestions", suggestions.Unit)
				@SuggestionDatalist("advanced-pension-state-suggestions", suggestions.PensionState)
				@SuggestionDatalist("advanced-confederate-home-name-suggestions", suggestions.ConfederateHome)
				@SuggestionDatalist("advanced-buried-in-suggestions", suggestions.BuriedIn)
				@SuggestionDatalist("advanced-relationship-label-suggestions", suggestions.RelationshipLabel)
			</div>
			<div id={ uiids.PanelSoldiersResults } class="contents">
				<div id="soldier-list" class="relative">
					@SearchResults(soldiers, viewmodel.PersonRecordSearch{Mode: "basic", Query: query}, page, total, 50)
				</div>
			</div>
		</div>
	}
}

templ SoldierDetail(s viewmodel.PersonRecord, tags []records.Tag, citedIn []viewmodel.Article) {
	@Layout(detailHeading(s)) {
			<div id={ uiids.PageSoldierDetail } data-scratchpad-display-id={ strings.TrimSpace(s.DisplayID) } data-recent-record-id={ fmt.Sprintf("%d", s.ID) } data-research-record-id={ fmt.Sprintf("%d", s.ID) } class="relative mx-auto max-w-4xl">
				<div class="mb-4 flex flex-wrap gap-3">
					<button
						type="button"
						data-history-back
						data-fallback-href={ strings.TrimSpace(s.BackLinkURL) }
						data-fallback-label={ backButtonLabel(s) }
						class="inline-flex items-center rounded-full border border-slate-300 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-research-border hover:bg-research-bg hover:text-research-text"
					>← { backButtonLabel(s) }</button>
				</div>
				<div class="relative card rounded-3xl p-5 sm:p-8">
					<div class="mb-6 flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
						<div>
							<h2 class="text-2xl font-bold">{ detailHeading(s) }</h2>
							if isSoldierEntry(s) && strings.TrimSpace(detailSubheading(s)) != "" {
								<p class="mt-2 text-sm text-slate-600">{ detailSubheading(s) }</p>
							}
						</div>
					<div class="flex w-full flex-col items-stretch gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:justify-end">
						<span class="gold self-start rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.4)] bg-white/70 px-4 py-2 text-sm font-mono">{ s.DisplayID }</span>
						<button type="button" data-share-queue-add={ fmt.Sprintf("%d", s.ID) } class="self-start rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--theme-accent-strong)] hover:bg-white" title={ "Add " + s.DisplayID + " to the Share Queue" }>
							+ Queue
						</button>
						<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/edit", s.ID)) } class="pill-link w-full justify-center sm:w-auto">Edit Person Record</a>
						<details class="relative w-full sm:w-auto">
							<summary class="secondary-button w-full list-none cursor-pointer justify-center gap-2 sm:w-auto">
								<span>Export Record</span>
								<span class="text-[0.68rem] uppercase tracking-[0.16em] text-[var(--theme-accent-strong)]">PDF / JPG</span>
							</summary>
							<form action={ templ.SafeURL(routebuilder.SoldierPDF(s.ID)) } data-dixie-submit="true" data-pdf-pref-scope="soldier" data-popout-panel class="absolute left-0 z-20 mt-3 w-[min(24rem,calc(100vw-3rem))] rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.28)] bg-[rgba(255,248,230,0.98)] p-4 shadow-[0_18px_32px_rgba(23,33,43,0.14)] sm:w-96 xl:left-auto xl:right-0">
								<div class="flex items-start justify-between gap-3">
									<p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--theme-accent-strong)]">Single Record Export</p>
									<button type="button" popovertarget="single-record-export-help" class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/85 text-sm font-bold text-[var(--theme-accent-strong)]">?</button>
								</div>
								<div id="single-record-export-help" data-popout-panel popover class="w-72 rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.28)] bg-white p-4 text-xs leading-5 text-slate-600 shadow-[0_18px_32px_rgba(23,33,43,0.14)]">
									<p class="font-semibold text-[var(--theme-text-primary)]">Which single-record report should I use?</p>
									<p class="mt-2"><strong>Portrait PDF/JPG</strong> keeps the image with the biography excerpt/override and uses a more compact single-record layout when it fits.</p>
									<p class="mt-2"><strong>Landscape PDF/JPG</strong> keeps page 1 concise and always renders the full biography on page 2 when a biography exists.</p>
									<p class="mt-2"><strong>JPG export</strong> mirrors the generated PDF pages.</p>
								</div>
								<div class="mt-3 grid gap-3 sm:grid-cols-2">
									<label class="block text-xs font-semibold uppercase tracking-[0.16em] text-[var(--theme-accent-strong)]">
										Format
										<select name="orientation" data-pdf-pref-key="orientation" class="mt-2 w-full rounded-lg border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white px-3 py-2 text-sm text-slate-700">
											<option value="L" selected>Landscape</option>
											<option value="P">Portrait</option>
										</select>
									</label>
									<div class="rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.2)] bg-white/70 px-3 py-3 text-sm text-slate-700">
										<label class="flex items-center gap-2">
											<input type="checkbox" name="printer_friendly" value="1" data-pdf-pref-key="printerFriendly" class="h-4 w-4 accent-[#8d7440]"/>
											<span>Printer-friendly</span>
										</label>
										<label class="mt-2 flex items-center gap-2">
											<input type="checkbox" name="include_images" value="1" checked data-pdf-pref-key="includeImages" class="h-4 w-4 accent-[#8d7440]"/>
											<span>Include images</span>
										</label>
									</div>
									<p class="sm:col-span-2 text-xs leading-5 text-slate-500">Single-record PDF and JPG exports use <strong>PDF excerpt override</strong> when present, otherwise <strong>biography</strong>. Internal notes and scratch pad content stay out of these exports.</p>
									<div class="sm:col-span-2 flex flex-col gap-2 pt-1 sm:flex-row sm:flex-wrap sm:justify-end">
										@components.Button("Export PDF", components.ButtonPrimary, "w-full sm:w-auto", templ.Attributes{
											"type": "submit",
										})
										@components.Button("Export JPG", components.ButtonSecondary, "w-full sm:w-auto", templ.Attributes{
											"type": "submit",
											"data-action": fmt.Sprintf("/soldiers/%d/jpg", s.ID),
											"data-dixie-submit": "true",
										})
									</div>
								</div>
							</form>
						</details>
						if s.LinkedSoldierID != 0 {
							<a href={ templ.SafeURL(fmt.Sprintf("/compare?id1=%d&id2=%d&from=%d", s.ID, s.LinkedSoldierID, s.ID)) } class="secondary-button w-full justify-center sm:w-auto">Compare Family Person Records</a>
						}
					</div>
				</div>
				if !isSoldierEntry(s) || s.LinkedSoldierID != 0 {
					<div class="mb-5 grid gap-4 lg:grid-cols-2">
						<div class="rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-[rgba(255,248,230,0.72)] p-4">
							<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-accent-strong)]">Family &amp; Relationships</p>
							<p class="mt-2 text-sm text-slate-600">Relationship details live here so they do not repeat in the summary area.</p>
							if !isSoldierEntry(s) {
								<dl class="mt-4 grid gap-2 text-sm text-slate-700">
									<dt class="text-slate-500">{ familyRelationshipLabel(s) }</dt>
									<dd>{ familyRelationshipValue(s) }</dd>
									<dt class="text-slate-500">Linked Soldier</dt>
									<dd>{ relationshipLabel(s) }</dd>
								</dl>
							}
							<div class="mt-4 flex flex-wrap gap-3">
								if s.LinkedSoldierID != 0 {
									<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d?from=%d", s.LinkedSoldierID, s.ID)) } class="primary-button">
										{ linkedSoldierActionLabel(s) }
									</a>
									<a href={ templ.SafeURL(fmt.Sprintf("/compare?id1=%d&id2=%d&from=%d", s.ID, s.LinkedSoldierID, s.ID)) } class="secondary-button">
										{ personRecordCompareActionLabel(s) }
									</a>
								}
							</div>
						</div>
					</div>
				}
				<div id={ uiids.PanelSoldierDetailSummary } class="contents">
				<dl class="responsive-two-col grid gap-2 text-sm">
					<dt class="text-slate-500">@components.TermDisclosure("person-record", components.TermDisclosurePersonRecordShort(), templ.Raw("Person Record "))<span class="ml-1">Type</span></dt><dd>{ entryBadgeLabel(s) }</dd>
					<dt class="text-slate-500">@components.TermDisclosure("display-id", components.TermDisclosureDisplayIDShort(), templ.Raw("Display ID"))</dt><dd>{ emptyDetail(s.DisplayID) }</dd>
					<dt class="text-slate-500">Middle Name</dt><dd>{ blankDetail(s.MiddleName) }</dd>
					if isSoldierEntry(s) {
						<dt class="text-slate-500">Rank In</dt><dd>{ blankDetail(s.RankIn) }</dd>
						<dt class="text-slate-500">Rank Out</dt><dd>{ blankDetail(detailDisplayRank(s)) }</dd>
						<dt class="text-slate-500">Unit</dt><dd>{ blankDetail(s.Unit) }</dd>
						<dt class="text-slate-500">Pension State</dt><dd>{ emptyDetail(s.PensionState) }</dd>
						<dt class="text-slate-500">Confederate Home Status</dt><dd>{ emptyDetail(s.ConfederateHomeStatus) }</dd>
						<dt class="text-slate-500">Confederate Home Name</dt><dd>{ emptyDetail(s.ConfederateHomeName) }</dd>
						<dt class="text-slate-500">Pension ID</dt><dd>{ emptyDetail(s.PensionID) }</dd>
						<dt class="text-slate-500">Application ID</dt><dd>{ emptyDetail(s.ApplicationID) }</dd>
					} else {
						<dt class="text-slate-500">Maiden Name</dt>
						<dd>
							if strings.TrimSpace(s.MaidenName) != "" {
								<em>{ s.MaidenName }</em>
							} else {
								{ emptyDetail(s.MaidenName) }
							}
						</dd>
						if isWidowEntry(s) {
							<dt class="text-slate-500">Pension ID</dt><dd>{ emptyDetail(s.PensionID) }</dd>
							<dt class="text-slate-500">Application ID</dt><dd>{ emptyDetail(s.ApplicationID) }</dd>
						}
					}
					<dt class="text-slate-500">Birth Date</dt><dd>{ dates.DisplayUnknown(s.BirthDate) }</dd>
					<dt class="text-slate-500">Death</dt><dd>{ deathDate(s) }</dd>
					<dt class="text-slate-500">Birth Info</dt><dd>{ emptyDetail(s.BirthInfo) }</dd>
					<dt class="text-slate-500">Buried In</dt><dd>{ emptyDetail(s.BuriedIn) }</dd>
				</dl>
				if s.Biography != "" {
					<div class="mt-5 rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.28)] bg-[rgba(255,248,230,0.48)] p-4">
						<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-accent-strong)]">Biography</p>
						@LinkedText(s.Biography, "mt-3 text-sm text-slate-700 leading-6")
					</div>
				}
				</div>
				<details class="mt-5 overflow-hidden rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgb(var(--theme-ink-deep-rgb)/0.04)]">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left">
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-accent-strong)]">Advanced Research &amp; Review</p>
							// Issue #455 slice 1: intro copy
							// trimmed to match the slim
							// 3-sub-page set (Timeline /
							// Research Log / Research
							// Collections). The older copy
							// advertised surfaces that were
							// slated for removal in slices
							// 3 + 4.
							<p class="mt-1 text-sm text-slate-500">Timelines, research logs, and named collections stay tucked away until you need them.</p>
						</div>
						<span class="rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.55)] bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-primary)]">Expand</span>
					</summary>
					<div class="border-t border-[rgb(var(--theme-sepia-rgb)/0.28)] px-4 py-4">
						<div class="grid gap-4 lg:grid-cols-2">
							if s.Notes != "" {
								<div class="rounded-2xl border border-slate-200 bg-white/80 p-4 lg:col-span-2">
									<p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Internal Notes</p>
									@LinkedText(s.Notes, "mt-3 text-sm text-slate-700 leading-6")
								</div>
							}
							// Issue #455 slice 1: Camaraderie
							// tile repurposed — the dedicated
							// sub-page is being deleted in
							// slice 3, so the tile now routes
							// to /insights/drilldown?scope=unit
							// (which already lists every
							// person record sharing the same
							// unit). soldierHasCamaraderie
							// predicate is unchanged: tile
							// only renders when there's a
							// non-empty unit to drill into.
							if soldierHasCamaraderie(s) {
								<div class="rounded-2xl border border-research-border bg-research-bg/80 p-4">
									<p class="text-xs font-semibold uppercase tracking-[0.24em] text-research-accent">Unit Camaraderie</p>
									<div class="mt-4 flex flex-wrap gap-3">
										<a href={ templ.SafeURL(fmt.Sprintf("/insights/drilldown?scope=unit&value=%s", url.QueryEscape(s.Unit))) } class="secondary-button">Open Unit on Insights</a>
									</div>
								</div>
							}
							if soldierHasTimeline(s) {
								<div class="rounded-2xl border border-[#d8c08d] bg-[rgba(255,248,230,0.78)] p-4">
									<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-accent-strong)]">Service Timeline</p>
									<div class="mt-4 flex flex-wrap gap-3">
										<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/timeline", s.ID)) } class="secondary-button">Open Timeline</a>
									</div>
								</div>
							}
							<div class="rounded-2xl border border-slate-200 bg-white/80 p-4">
								<p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Research Log</p>
								<div class="mt-4 flex flex-wrap gap-3">
									<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/research-log", s.ID)) } class="secondary-button">Open Research Log</a>
								</div>
							</div>
							// Issue #455 slice 1: Research
							// Packs tile removed (the
							// dedicated sub-page is being
							// deleted in slice 3 — the same
							// Top Units / Top Cemeteries /
							// Related Person Records panels
							// already live on Insights).
							<div class="rounded-2xl border border-slate-200 bg-white/80 p-4">
								<p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Research Collections</p>
								<div class="mt-4 flex flex-wrap gap-3">
									<a href={ templ.SafeURL(fmt.Sprintf("/research-collections?from=%d", s.ID)) } class="secondary-button">Manage Collections</a>
								</div>
							</div>
							// Issue #455 slice 1: Merge Review
							// Ledger tile removed (the
							// dedicated sub-page is being
							// deleted in slice 4 — same data
							// surfaces as the Resolved tab
							// on Review Queue). The Review
							// Queue tile below is unchanged
							// (it's the live review-state
							// surface, not the historical
							// ledger).
							<div class="rounded-2xl border border-[rgb(var(--theme-review-red-rgb)/0.35)] bg-[rgb(var(--theme-review-red-rgb)/0.08)] p-4 lg:col-span-2">
								<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-review-red)]">Review Queue</p>
								if s.NeedsReview {
									<p class="mt-2 text-sm text-[var(--theme-review-red)]">{ emptyDetail(s.ReviewReason) }</p>
								} else {
									<p class="mt-2 text-sm text-[var(--theme-review-red)]">Manually flag this person record for follow-up research or duplicate checking and it will appear in the review queue.</p>
								}
								<form action={ templ.SafeURL(routebuilder.SoldierReviewFlag(s.ID)) } data-dixie-submit="true" class="mt-4 space-y-3">
									<label class="block text-sm font-medium text-[var(--theme-review-red)]">
										Review Note
										<textarea name="review_reason" rows="3" class="field-input mt-2 min-h-24" placeholder="Example: Check pension packet against widow person record or verify duplicate candidate.">{ s.ReviewReason }</textarea>
									</label>
									<div class="flex flex-wrap gap-3">
										if s.NeedsReview {
											@components.Button("Update Review Note", components.ButtonPrimary, "", templ.Attributes{"type": "submit"})
										} else {
											@components.Button("Send to Review Queue", components.ButtonPrimary, "", templ.Attributes{"type": "submit"})
										}
										if s.NeedsReview {
											<a href="/review-queue" class="secondary-button">Open Review Queue</a>
											@components.Button("Mark as Resolved", components.ButtonSecondary, "", templ.Attributes{
												"data-action": fmt.Sprintf("/soldiers/%d/review/resolve", s.ID),
												"data-dixie-submit": "true",
											})
										}
									</div>
								</form>
							</div>
						</div>
					</div>
				</details>
				<details class="mt-5 overflow-hidden rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgb(var(--theme-ink-deep-rgb)/0.04)]">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-left">
						<div>
							<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-accent-strong)]">Record Metadata &amp; History</p>
							<p class="mt-1 text-sm text-slate-500">Created/updated provenance and the latest tracked field changes.</p>
						</div>
						<span class="rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.55)] bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-primary)]">Expand</span>
					</summary>
					<div class="border-t border-[rgb(var(--theme-sepia-rgb)/0.28)] px-4 py-4">
						<dl class="responsive-two-col grid gap-2 text-sm">
							<dt class="text-slate-500">Review Status</dt><dd>{ reviewStatusLabel(s) }</dd>
							<dt class="text-slate-500">Review Reason</dt><dd>{ emptyDetail(s.ReviewReason) }</dd>
							<dt class="text-slate-500">Created By</dt><dd>{ emptyDetail(s.AddedBy) }</dd>
							<dt class="text-slate-500">Last Updated By</dt><dd>{ emptyDetail(s.LastEditedBy) }</dd>
							<dt class="text-slate-500">Last Update Time</dt><dd>{ emptyDetail(formatAuditTimestamp(s.LastEditedAt)) }</dd>
						</dl>
						<div class="mt-4">
							<p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--theme-accent-strong)]">Recent Field Changes</p>
							if len(auditHistoryLines(s.LastEditedFields)) == 0 {
								<p class="mt-2 text-sm text-slate-500">No tracked field changes are available for this person record.</p>
							} else {
								<ul class="mt-3 space-y-2 text-sm text-slate-600">
									for _, line := range auditHistoryLines(s.LastEditedFields) {
										<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-white/70 px-3 py-2 leading-6">{ line }</li>
									}
								</ul>
							}
						</div>
					</div>
				</details>
				<div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[#d8c08d] bg-[rgba(255,248,230,0.75)] p-4">
					<div class="flex flex-wrap gap-3">
						<button
							type="button"
							data-history-back
							data-fallback-href={ soldierDetailBackHref(s) }
							data-fallback-label={ backButtonLabel(s) }
							class="ghost-link px-5 py-3 text-base font-semibold"
						>← { backButtonLabel(s) }</button>
					</div>
					<p class="text-sm text-slate-500">Primary work stays at the top of the page. Return actions stay here.</p>
				</div>
				<div class="mt-5 rounded-2xl border border-[rgb(var(--theme-review-red-rgb)/0.42)] bg-[rgb(var(--theme-review-red-rgb)/0.08)] p-4">
					<p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--theme-review-red)]">Danger Zone</p>
					<div class="mt-4">
						@components.Button("Delete Person Record", components.ButtonDanger, "", templ.Attributes{
							"data-action": fmt.Sprintf("/soldiers/%d/delete", s.ID),
							"data-confirm": "Delete this Person Record? It will also remove every Source Record attached to it, every image file, the spouse link, the scratch pad, and any research tasks. This cannot be undone from within the app. Restore from your most recent .ddbak if you need to recover.",
							"data-dixie-submit": "true",
						})
					</div>
				</div>
				if len(s.SourceRecords) > 0 {
					<section id={ uiids.PanelSoldierDetailRecords } class="relative">
						<h3 class="mt-8 text-lg gold font-semibold">@components.TermDisclosure("source-record", components.TermDisclosureSourceRecordShort(), templ.Raw("Source Records"))</h3>
						@SoldierRecordsListFragment(s.ID, s.SourceRecords)
					</section>
				}
				<section class="relative">
					<h3 class="mt-8 text-lg gold font-semibold">Images</h3>
					<form action={ templ.SafeURL(routebuilder.SoldierImagesDownload(s.ID)) } data-dixie-submit="true" class="mt-2">
						<div class="mb-4 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-600 lg:flex-row lg:items-center lg:justify-between">
							<label class="inline-flex items-center gap-2 font-medium text-slate-700">
								<input type="checkbox" data-select-all="soldier-images" class="h-4 w-4 rounded border-slate-300 text-[#7b1e2b] focus:ring-[#7b1e2b]"/>
								Select all images
							</label>
							<div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
														// Issue #682: same structural fix as entry_form.templ.
						// The inner file-upload form was nested inside the
						// outer images-download form, which violates HTML5
						// and silently closes the outer form at the parser
						// (the Download Selected Images submit button ends
						// up reparented). The upload is now a
						// [data-image-upload] div, not a <form>, and the
						// file input POSTs via handleImageUpload.
						<div
							data-image-upload
							data-upload-url={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/images/import", s.ID)) }
							data-results-target={ "#" + uiids.PanelSoldierDetailImages }
							class="inline"
						>
							<label class="primary-button w-full sm:w-auto cursor-pointer">
								Add Images From Computer
								<input
									type="file"
									name="images"
									multiple
									accept="image/png,image/jpeg,image/gif,image/bmp,image/webp,image/svg+xml"
									class="hidden"
									onchange="handleImageUpload(this)"
								/>
							</label>
						</div>

								if len(s.Images) > 0 {
									@components.Button("Download Selected Images", components.ButtonPrimary, "w-full sm:w-auto", templ.Attributes{"type": "submit"})
									@components.Button("Delete Selected Images", components.ButtonDanger, "w-full sm:w-auto", templ.Attributes{
										"data-action": routebuilder.SoldierImagesDelete(s.ID),
										"data-dixie-submit": "true",
										"data-confirm": "Delete the selected image(s)?",
										"data-results-target": "#" + uiids.PanelSoldierDetailImages,
									})
								}
							</div>
						</div>
						if len(s.Images) > 0 {
							<div id={ uiids.PanelSoldierDetailImages }>
								@SoldierImagesListFragment(s.ID, s.DisplayID, s.Images)
							</div>
						} else {
							<div id={ uiids.PanelSoldierDetailImages }>
								@SoldierImagesListFragment(s.ID, s.DisplayID, s.Images)
							</div>
						}
						<div id="image-download-status" class="mt-3 text-sm text-slate-600"></div>
					</form>
				</section>
				<div class="mt-6 rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgba(255,248,230,0.62)] p-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-accent-strong)]">Tags</p>
						<span class="text-xs text-slate-500">{ fmt.Sprintf("%d applied", len(tags)) }</span>
					</div>
					if len(tags) == 0 {
						<p class="mt-3 text-sm text-slate-600">No tags. Add a virtual cemetery or category to group this Person Record with others.</p>
					} else {
						<ul class="mt-3 flex flex-wrap gap-2">
							for _, t := range tags {
								<li class="inline-flex items-center gap-1 rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-white px-3 py-1 text-xs font-semibold text-slate-800">
									<span>{ t.Name }</span>
									<form action={ templ.SafeURL(routebuilder.SoldierTagDetach(s.ID, t.ID)) } method="post" data-dixie-submit="true" data-reload-on-success="true" class="inline">
										<button type="submit" class="ml-1 text-[var(--theme-review-red)]" aria-label={ fmt.Sprintf("Remove tag %s", t.Name) } title="Remove">×</button>
									</form>
								</li>
							}
						</ul>
					}
					<details class="mt-3 group">
						<summary class="cursor-pointer text-sm font-semibold text-[var(--theme-accent-strong)]">+ Add tag</summary>
						<form action={ templ.SafeURL(routebuilder.SoldierTagAttach(s.ID)) } method="post" data-dixie-submit="true" data-reload-on-success="true" class="mt-3 flex flex-wrap items-center gap-2">
							<input type="text" name="tag_name" placeholder="Tag name (e.g. vc-shiloh)" class="w-72 rounded border border-slate-300 px-3 py-2 text-sm" required autocomplete="off"/>
							<button type="submit" class="inline-flex items-center rounded-2xl border border-[var(--theme-accent-strong)] bg-[var(--theme-accent-strong)] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#7a6635]">Apply</button>
						</form>
					</details>
				</div>
				if provenanceFooterVisible(s) {
					@ProvenanceFooter(s)
				}
			</div>
		</div>
		if len(citedIn) > 0 {
			@components.CitedInArticles(s.ID, citedIn)
		}
	}
}

// SoldierRecordsListFragment renders the Source Records list
// for the Person detail page (issue #368 slice 3). Each row
// carries up/down arrow buttons + a numeric position input that
// PATCH /soldiers/{id}/sources/{sourceId}/position with the new
// position. The arrows use hidden inputs to encode the target
// position; the position input takes a user-typed value. Disabled
// state for the arrows prevents clicking past either end.
templ SoldierRecordsListFragment(soldierID int64, records []viewmodel.SourceRecord) {
	<ol class="space-y-3 mt-3" data-source-records-list>
		for i, r := range records {
			<li class="card rounded-2xl p-4 text-sm" data-source-record-id={ fmt.Sprintf("%d", r.ID) }>
				<div class="flex flex-wrap items-center gap-2">
					<div class="flex-1 min-w-0">
						<span class="gold">{ r.SourceRecordType }</span>
						if r.AppID != "" {
							<span class="ml-2 text-slate-500">App: { r.AppID }</span>
						}
						@RecordDetails(r.Details, "text-slate-600 mt-2 leading-6")
					</div>
					<div class="flex items-center gap-1 shrink-0">
						<form
							method="patch"
							action={ templ.SafeURL(routebuilder.SoldierSourcePosition(soldierID, r.ID)) }
							data-dixie-submit="true"
							data-reload-on-success="true"
							class="inline"
						>
							<input type="hidden" name="position" value={ fmt.Sprintf("%d", i) }/>
							<button
								type="submit"
								class="icon-link"
								if i == 0 {
									disabled
								}
								aria-label="Move up"
								data-source-record-move="up"
								data-source-record-id={ fmt.Sprintf("%d", r.ID) }
							>▲</button>
						</form>
						<form
							method="patch"
							action={ templ.SafeURL(routebuilder.SoldierSourcePosition(soldierID, r.ID)) }
							data-dixie-submit="true"
							data-reload-on-success="true"
							class="inline"
						>
							<input
								type="number"
								name="position"
								value={ fmt.Sprintf("%d", i+1) }
								min="1"
								max={ fmt.Sprintf("%d", len(records)) }
								class="w-14 rounded-2xl border border-[var(--theme-accent-strong)] bg-[rgba(36,48,61,0.6)] px-2 py-1 text-center text-sm text-[color:var(--ink)]"
								data-source-record-position
								data-source-record-id={ fmt.Sprintf("%d", r.ID) }
							/>
						</form>
						<form
							method="patch"
							action={ templ.SafeURL(routebuilder.SoldierSourcePosition(soldierID, r.ID)) }
							data-dixie-submit="true"
							data-reload-on-success="true"
							class="inline"
						>
							<input type="hidden" name="position" value={ fmt.Sprintf("%d", i+2) }/>
							<button
								type="submit"
								class="icon-link"
								if i == len(records)-1 {
									disabled
								}
								aria-label="Move down"
								data-source-record-move="down"
								data-source-record-id={ fmt.Sprintf("%d", r.ID) }
							>▼</button>
						</form>
					</div>
				</div>
			</li>
		}
	</ol>
}


// SoldierImagesListFragment (issue #391 Slice B.1) renders
// the per-soldier Images panel as a fragment-only payload
// (no <html>/<body>/Layout() shell) so htmx can swap it in
// place via the data-results-target on the Delete form.
// Mirrors EventImagesListFragment shape (event_panels.templ:93)
// — empty-state + grid of cards with the same per-card
// data-image-card / data-image-thumb-id / data-image-id
// selectors Slice A preserved. B.2 expands each card with
// per-card Delete + Set-Primary forms; this slice ships the
// fragment spine so the route + handler can swap without
// per-card forms yet. The card markup here matches the
// pre-Slice-B inline loop byte-for-byte so Slice A's
// selector pins keep passing unchanged.
templ SoldierImagesListFragment(soldierID int64, displayID string, images []viewmodel.Image) {
	if len(images) == 0 {
		<p class="rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-600">No images are attached yet. Use <strong>Add Images From Computer</strong> to import one or more files with the desktop file picker.</p>
	} else {
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			for _, img := range images {
				<div data-image-card data-image-id={ fmt.Sprintf("%d", img.ID) } class="card rounded-2xl p-3">
					<div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
						<label class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-slate-500">
							<input type="checkbox" name="image_ids" value={ fmt.Sprintf("%d", img.ID) } data-checkbox-group="soldier-images" class="h-4 w-4 rounded border-slate-300 text-[#7b1e2b] focus:ring-[#7b1e2b]"/>
							Select
						</label>
						<div class="flex w-full flex-col items-stretch gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center sm:justify-end">
							<span data-image-primary-badge class={ primaryImageBadgeClass(img.IsPrimary) }>Primary Image</span>
							// issue #407: convert per-card actions
							// (Set as Primary, Delete) from JS-dispatcher
							// form/button pattern to htmx-driven buttons.
							// The previous <form>-based Delete was nested
							// inside the outer bulk-download <form> at
							// soldier_card.templ:559, so the document-level
							// submit listener at frontend/app.js:5344 never
							// received the inner submit event before the
							// browser did native form submission. htmx
							// intercepts the click directly (no form), builds
							// the FormData from hx-vals, posts, and swaps the
							// fragment. No form nesting, no JS dispatcher
							// dependency. hx-confirm preserves the
							// confirmation-dialog UX. Mirrors the upload
							// form pattern that #404 introduced.
							<button
								type="button"
								data-image-primary-action
								data-primary-image-id={ fmt.Sprintf("%d", img.ID) }
								{ htmxattr.Mux{
									Post: routebuilder.SoldierImagesPrimary(soldierID, img.ID),
									Target: "[id=\"" + uiids.PanelSoldierDetailImages + "\"]",
									Swap: "innerHTML",
								}.Attrs()... }
								class={ primaryImageButtonClass(img.IsPrimary) + " w-full justify-center sm:w-auto" }
							>Set as Primary</button>
							<button type="button" data-image-preview-id={ fmt.Sprintf("%d", img.ID) } data-image-preview={ string(imageURL(img.FilePath)) } data-image-caption={ img.Caption } data-image-file={ img.FileName } class="pill-link w-full justify-center sm:w-auto">Preview</button>
							<button
								type="button"
								data-image-delete-button={ fmt.Sprintf("%d", img.ID) }
								hx-vals={ fmt.Sprintf(`{"image_ids":"%d"}`, img.ID) }
								{ htmxattr.Mux{
									Post: routebuilder.SoldierImagesDelete(soldierID),
									Target: "[id=\"" + uiids.PanelSoldierDetailImages + "\"]",
									Swap: "innerHTML",
									Confirm: "Delete this image?",
								}.Attrs()... }
								class="pill-link w-full justify-center sm:w-auto"
							>Delete</button>
						</div>
					</div>
					<img src={ imageURL(img.FilePath) } data-image-thumb-id={ fmt.Sprintf("%d", img.ID) } alt={ imageAltText(img.Caption, displayID) }
						class="mb-3 h-40 w-full rounded-xl bg-slate-50 object-contain"/>
					<div class="text-sm gold font-medium">{ img.Caption }</div>
					<div class="text-xs text-slate-500 break-all">{ img.FileName }</div>
				</div>
			}
		</div>
	}
}

func searchSummary(search viewmodel.PersonRecordSearch) string {
	if search.Mode != "advanced" {
		if search.Browse {
			return "Browse: alphabetical list"
		}
		if strings.TrimSpace(search.Query) == "" {
			return ""
		}
		return fmt.Sprintf("Search: %q", search.Query)
	}

	parts := []string{}
	if search.DisplayID != "" {
		parts = append(parts, "Display ID "+search.DisplayID)
	}
	if search.EntryType != "" {
		switch strings.ToLower(strings.TrimSpace(search.EntryType)) {
		case models.EntryTypeLinkedPerson:
			parts = append(parts, "Entry type Person Record")
		case models.EntryTypeWife:
			parts = append(parts, "Entry type Wife")
		case models.EntryTypeWidow:
			parts = append(parts, "Entry type Widow")
		default:
			parts = append(parts, "Entry type Soldier")
		}
	}
	if search.FirstName != "" {
		parts = append(parts, "First name "+search.FirstName)
	}
	if search.MiddleName != "" {
		parts = append(parts, "Middle name "+search.MiddleName)
	}
	if search.LastName != "" {
		parts = append(parts, "Last name "+search.LastName)
	}
	if search.RelationshipLabel != "" {
		parts = append(parts, "Relationship "+search.RelationshipLabel)
	}
	if search.MaidenName != "" {
		parts = append(parts, "Maiden name "+search.MaidenName)
	}
	if search.Rank != "" {
		parts = append(parts, "Rank "+search.Rank)
	}
	if search.RankIn != "" {
		parts = append(parts, "Rank in "+search.RankIn)
	}
	if search.RankOut != "" {
		parts = append(parts, "Rank out "+search.RankOut)
	}
	if search.Unit != "" {
		parts = append(parts, "Unit "+search.Unit)
	}
	if search.SourceRecordType != "" {
		parts = append(parts, "Source record type "+search.SourceRecordType)
	}
	if search.PensionState != "" {
		parts = append(parts, "Pension state "+search.PensionState)
	}
	if search.ConfederateHomeStatus != "" {
		parts = append(parts, "Confederate home status "+search.ConfederateHomeStatus)
	}
	if search.ConfederateHomeName != "" {
		parts = append(parts, "Confederate home name "+search.ConfederateHomeName)
	}
	if search.BuriedIn != "" {
		parts = append(parts, "Buried in "+search.BuriedIn)
	}
	if search.ReviewStatus != "" {
		switch strings.ToLower(strings.TrimSpace(search.ReviewStatus)) {
		case "clean":
			parts = append(parts, "Clean person records only")
		case "review":
			parts = append(parts, "Review queue only")
		}
	}
	if search.BirthDate != "" {
		parts = append(parts, "Birth date "+search.BirthDate)
	}
	if search.BirthYear != "" && search.BirthYearTo != "" {
		parts = append(parts, "Birth year "+search.BirthYear+"-"+search.BirthYearTo)
	} else if search.BirthYear != "" {
		parts = append(parts, "Birth year "+search.BirthYear)
	} else if search.BirthYearTo != "" {
		parts = append(parts, "Birth year through "+search.BirthYearTo)
	}
	if search.DeathDate != "" {
		parts = append(parts, "Death date "+search.DeathDate)
	}
	if search.DeathYear != "" && search.DeathYearTo != "" {
		parts = append(parts, "Death year "+search.DeathYear+"-"+search.DeathYearTo)
	} else if search.DeathYear != "" {
		parts = append(parts, "Death year "+search.DeathYear)
	} else if search.DeathYearTo != "" {
		parts = append(parts, "Death year through "+search.DeathYearTo)
	}
	if search.DeathMonth != "" {
		parts = append(parts, "Death month "+search.DeathMonth)
	}
	if search.DeathDay != "" {
		parts = append(parts, "Death day "+search.DeathDay)
	}
	if len(parts) == 0 {
		return "Advanced search"
	}
	return "Advanced filters: " + strings.Join(parts, ", ")
}

func reviewStatusLabel(s viewmodel.PersonRecord) string {
	if s.NeedsReview {
		return "Needs Review"
	}
	return "Clean"
}

func soldierFullName(s viewmodel.PersonRecord) string {
	return s.GetFullName()
}

func isSoldierEntry(s viewmodel.PersonRecord) bool {
	return strings.TrimSpace(s.EntryType) == "" || s.EntryType == models.EntryTypeSoldier
}

func soldierHasCamaraderie(s viewmodel.PersonRecord) bool {
	return isSoldierEntry(s) && strings.TrimSpace(s.Unit) != ""
}

func soldierHasTimeline(s viewmodel.PersonRecord) bool {
	if !isSoldierEntry(s) {
		return false
	}
	if strings.TrimSpace(s.BirthDate) != "" || strings.TrimSpace(s.BirthInfo) != "" || strings.TrimSpace(s.DeathDate) != "" {
		return true
	}
	if s.DeathYear > 0 || s.DeathMonth > 0 || s.DeathDay > 0 {
		return true
	}
	return len(s.SourceRecords) > 0
}

func soldierStateResearchPackLabel(s viewmodel.PersonRecord) string {
	if trimmed := strings.TrimSpace(s.PensionState); trimmed != "" {
		return trimmed
	}
	_, state := soldierBirthInfoResearchPackLabels(s.BirthInfo)
	return state
}

func soldierCountyResearchPackLabel(s viewmodel.PersonRecord) string {
	county, _ := soldierBirthInfoResearchPackLabels(s.BirthInfo)
	return county
}

func soldierHasResearchPack(s viewmodel.PersonRecord) bool {
	return soldierStateResearchPackLabel(s) != "" || soldierCountyResearchPackLabel(s) != ""
}

func soldierBirthInfoResearchPackLabels(value string) (string, string) {
	trimmed := strings.TrimSpace(value)
	if trimmed == "" {
		return "", ""
	}
	countyStatePattern := regexp.MustCompile(`(?i)\b(?:in\s+)?([A-Za-z .'-]+ County),\s*([A-Za-z .'-]+)\b`)
	if match := countyStatePattern.FindStringSubmatch(trimmed); len(match) == 3 {
		county := strings.TrimSpace(match[1])
		if len(county) > 3 && strings.EqualFold(county[:3], "in ") {
			county = strings.TrimSpace(county[3:])
		}
		return county, strings.Trim(strings.TrimSpace(match[2]), ". ")
	}
	stateTailPattern := regexp.MustCompile(`(?i),\s*([A-Za-z .'-]+)\.?\s*$`)
	if match := stateTailPattern.FindStringSubmatch(trimmed); len(match) == 2 {
		return "", strings.Trim(strings.TrimSpace(match[1]), ". ")
	}
	return "", ""
}

func isWidowEntry(s viewmodel.PersonRecord) bool {
	return s.EntryType == models.EntryTypeWidow
}

// v60 (issue #320): Event Record entry-type predicate. Used
// by detail-heading / subheading logic and the entry-form
// JS dispatcher to gate the event-only field set. Mirrors
// isSoldierEntry / isWidowEntry so a single switch in the JS
// dispatcher covers every Person Record subtype.
func isEventEntry(s viewmodel.PersonRecord) bool {
	return s.EntryType == models.EntryTypeEvent
}

func entryBadgeLabel(s viewmodel.PersonRecord) string {
	switch s.EntryType {
	case models.EntryTypeWife:
		return "Wife"
	case models.EntryTypeWidow:
		return "Widow"
	case models.EntryTypeLinkedPerson:
		return "Person Record"
	// v60 (issue #320): Event Record badge. Used on browse
	// rows, Person Record detail chips, and the entry-form
	// header so the user always sees the entry type without
	// re-reading the form.
	case models.EntryTypeEvent:
		return "Event"
	default:
		return "Soldier"
	}
}

func detailHeading(s viewmodel.PersonRecord) string {
	name := strings.TrimSpace(soldierFullName(s))
	if isSoldierEntry(s) {
		if name != "" {
			return name
		}
		return entryBadgeLabel(s)
	}
	if name != "" {
		return name
	}
	return entryBadgeLabel(s)
}

func detailSubheading(s viewmodel.PersonRecord) string {
	if isSoldierEntry(s) {
		return soldierServiceLine(s)
	}
	if strings.TrimSpace(s.RelationshipLabel) != "" {
		return strings.TrimSpace(s.RelationshipLabel)
	}
	if strings.TrimSpace(s.SpouseName) != "" {
		return "Married to " + strings.TrimSpace(s.SpouseName)
	}
	return strings.TrimSpace(s.MaidenName)
}

func soldierServiceLine(s viewmodel.PersonRecord) string {
	return persondisplay.SoldierServiceLine(s.RankOut, s.Rank, s.RankIn, s.Unit)
}

func relationshipLabel(s viewmodel.PersonRecord) string {
	name := strings.TrimSpace(s.SpouseName)
	displayID := strings.TrimSpace(s.SpouseDisplayID)
	switch {
	case name != "" && displayID != "":
		return name + " (" + displayID + ")"
	case name != "":
		if s.LinkedSoldierID > 0 {
			return fmt.Sprintf("%s (DB ID %d)", name, s.LinkedSoldierID)
		}
		return name
	case displayID != "":
		return displayID
	case s.LinkedSoldierID > 0:
		return fmt.Sprintf("DB ID %d", s.LinkedSoldierID)
	default:
		return "N/A"
	}
}

func familyRelationshipLabel(s viewmodel.PersonRecord) string {
	if s.EntryType == models.EntryTypeLinkedPerson {
		return "Relationship to Soldier"
	}
	return "Married To"
}

func familyRelationshipValue(s viewmodel.PersonRecord) string {
	if s.EntryType == models.EntryTypeLinkedPerson {
		return emptyDetail(s.RelationshipLabel)
	}
	return emptyDetail(s.SpouseName)
}

func linkedSoldierActionLabel(s viewmodel.PersonRecord) string {
	if s.EntryType == models.EntryTypeLinkedPerson {
		return "View Linked Soldier"
	}
	return "View Husband"
}

func personRecordCompareActionLabel(s viewmodel.PersonRecord) string {
	if s.EntryType == models.EntryTypeLinkedPerson {
		return "Compare Person Records"
	}
	return "Compare Family Person Records"
}

func backButtonLabel(s viewmodel.PersonRecord) string {
	if strings.TrimSpace(s.BackLinkLabel) != "" {
		return s.BackLinkLabel
	}
	return "Back"
}

func soldierDetailBackHref(s viewmodel.PersonRecord) string {
	if strings.TrimSpace(s.BackLinkURL) != "" {
		return strings.TrimSpace(s.BackLinkURL)
	}
	return "/soldiers"
}

func detailDisplayRank(s viewmodel.PersonRecord) string {
	if trimmed := strings.TrimSpace(s.RankOut); trimmed != "" {
		return trimmed
	}
	if trimmed := strings.TrimSpace(s.Rank); trimmed != "" {
		return trimmed
	}
	return strings.TrimSpace(s.RankIn)
}

templ LinkedText(text string, className string) {
	<div class={ className }>
		for lineIndex, line := range linkifiedLines(text) {
			if lineIndex > 0 {
				<br/>
			}
			for _, segment := range line {
				if segment.Href != "" {
					<a
						href={ templ.SafeURL(segment.Href) }
						if segment.IsExternal {
							data-open-external="true"
							target="_blank"
							rel="noreferrer noopener"
						}
						class="text-[#7b1e2b] underline underline-offset-2 break-all"
					>{ segment.Text }</a>
				} else {
					{ segment.Text }
				}
			}
		}
	</div>
}

// RecordDetails renders a Source Record details field (issue #541).
// When the field is a single http(s) URL, it collapses to a
// "Click to view" anchor with the URL hidden — mirroring
// templates/common/record_card.typ::render-link and the JS
// printRenderLink helper. Freeform text passes through as plain
// text (no link wrapper). Trailing punctuation detaches so
// "https://example.com." renders the period after the anchor.
templ RecordDetails(text string, className string) {
	<div class={ className }>
		for _, seg := range recordDetailsSegments(text) {
			if seg.IsURL {
				@recordDetailsAnchor(seg)
			} else {
				{ seg.Text }
			}
		}
	</div>
}

templ recordDetailsAnchor(seg recordDetailsSegment) {
	if safeRecordDetailsHref(seg.Href) != "" && isRecordDetailsURLAcceptable(seg.Href) {
		<a
			href={ templ.SafeURL(safeRecordDetailsHref(seg.Href)) }
			target="_blank"
			rel="noreferrer noopener"
			class="text-[#7b1e2b] underline underline-offset-2"
		>{ recordDetailsAnchorText }</a>
		if seg.Suffix != "" {
			{ seg.Suffix }
		}
	} else {
		// Fallback: render the URL as plain text. Mirrors Typst's
		// fall-through for overlong URLs and the JS helper's
		// non-URL passthrough.
		{ seg.Href }
		if seg.Suffix != "" {
			{ seg.Suffix }
		}
	}
}

func imageURL(filePath string) templ.SafeURL {
	cleaned := filepath.ToSlash(strings.TrimSpace(filePath))
	if cleaned == "" {
		return templ.SafeURL("#")
	}
	if filepath.IsAbs(filePath) {
		return templ.SafeURL("file:///" + strings.TrimPrefix(cleaned, "/"))
	}
	return templ.SafeURL("/media/" + strings.TrimPrefix(cleaned, "/"))
}

// imageAltText returns the alt text for an image thumbnail. It strips
// HTML tags so the alt text never contains raw markup, and falls back
// to a Person-Record-scoped identifier so the image is never silently
// exposed to assistive tech with an empty alt.
func imageAltText(caption, displayID string) string {
	trimmed := strings.TrimSpace(stripImageTags(caption))
	if trimmed != "" {
		return trimmed
	}
	if id := strings.TrimSpace(displayID); id != "" {
		return "Image for Person Record " + id
	}
	return "Image attached to Person Record"
}

// stripImageTags removes HTML angle-bracket markup so an image caption
// pasted from another source never lands in an alt attribute as raw
// markup. Intentionally simple: anything between < and > is dropped,
// then interior whitespace is collapsed.
func stripImageTags(value string) string {
	if !strings.ContainsAny(value, "<>") {
		return value
	}
	var b strings.Builder
	b.Grow(len(value))
	inTag := false
	for _, r := range value {
		switch {
		case r == '<':
			inTag = true
		case r == '>':
			inTag = false
		case !inTag:
			b.WriteRune(r)
		}
	}
	return strings.TrimSpace(b.String())
}

func primaryImageBadgeClass(isPrimary bool) string {
	className := "rounded-full bg-[rgb(var(--theme-sepia-rgb)/0.14)] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-[var(--theme-accent-strong)]"
	if !isPrimary {
		className += " hidden"
	}
	return className
}

func primaryImageButtonClass(isPrimary bool) string {
	className := "pill-link"
	if isPrimary {
		className += " hidden"
	}
	return className
}

// provenanceFooterVisible returns true when at least one of the
// three provenance fields is populated. The footer is hidden
// entirely on a row that pre-dates v64 (no CreatedBy* stamp, no
// restored_at stamp) so a fully-unknown row does not surface a
// "Created by unknown" / "Restored at unknown" line — absence
// IS the signal.
func provenanceFooterVisible(s viewmodel.PersonRecord) bool {
	return strings.TrimSpace(s.CreatedByVersion) != "" ||
		strings.TrimSpace(s.CreatedByImportPath) != "" ||
		strings.TrimSpace(s.RestoredAt) != ""
}

// provenanceCreatedLine returns the v64 footer line: "Created
// by DixieData v1.2.N via <path>". Returns "" when both
// fields are empty so the templ can skip the <p> entirely.
func provenanceCreatedLine(s viewmodel.PersonRecord) string {
	version := strings.TrimSpace(s.CreatedByVersion)
	path := strings.TrimSpace(s.CreatedByImportPath)
	switch {
	case version == "" && path == "":
		return ""
	case version == "":
		return fmt.Sprintf("Created by DixieData via %s", path)
	case path == "":
		return fmt.Sprintf("Created by DixieData %s", version)
	default:
		return fmt.Sprintf("Created by DixieData %s via %s", version, path)
	}
}

// provenanceRestoredLine returns the v65 footer line: "Restored
// at <human-readable timestamp>". Returns "" when RestoredAt
// is empty so the templ can skip the <p> entirely.
func provenanceRestoredLine(s viewmodel.PersonRecord) string {
	ts := strings.TrimSpace(s.RestoredAt)
	if ts == "" {
		return ""
	}
	parsed, err := time.Parse(time.RFC3339, ts)
	if err != nil {
		// Fall back to the raw timestamp if it isn't
		// RFC3339 (shouldn't happen in practice — the
		// stamp is always time.Now().UTC().Format(time.RFC3339)
		// — but the helper must not panic on legacy data).
		return fmt.Sprintf("Restored at %s", ts)
	}
	return fmt.Sprintf("Restored at %s", parsed.Local().Format("Jan 2, 2006 at 3:04 PM MST"))
}

// ProvenanceFooter renders the two-line provenance footer
// below the Tags section on the Soldier detail page. Each
// line is hidden when its source field is empty; the whole
// footer is hidden when no provenance field is populated.
templ ProvenanceFooter(s viewmodel.PersonRecord) {
	<div id={ uiids.PanelSoldierDetailProvenance } class="mt-4 border-t border-[rgb(var(--theme-sepia-rgb)/0.18)] pt-3 text-xs text-slate-500">
		if created := provenanceCreatedLine(s); created != "" {
			<p data-provenance-created>{ created }</p>
		}
		if restored := provenanceRestoredLine(s); restored != "" {
			<p data-provenance-restored class="mt-1">{ restored }</p>
		}
	</div>
}
