package templates

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/buildinfo"
	"github.com/valueforvalue/DixieData/internal/debug"
	"github.com/valueforvalue/DixieData/internal/htmxattr"
	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/uiids"
)

// Layout is the single shell used across the app. The previous
// `?ui=v2` dispatch + LayoutV2 variant were dropped: issue #74's
// component-primitive refactor was abandoned, so v2 had no production
// users and was dead code.
//
// omitJobsOverlay strips the global jobs-progress popup from the
// layout. Pages pass true when they already render the job's
// status inline (e.g. /jobs/{id} shows the running job's progress
// bar in the body and would render the same progress twice if the
// popup also appeared). Defaults to false everywhere else.
//
// currentPath is read implicitly via layoutCurrentPath(ctx)
// (tagged onto the request context by the appshell ServeHTTP
// wrapper before the mux dispatches). See layout_helpers.go and
// internal/templates/uictx.go for the per-request tagging flow.
// Issue #466: prior shape used a package-level global set via
// SetCurrentPagePath; the race detector found a data race on
// that global under httptest.NewServer's concurrent ServeHTTP,
// and the race itself slowed the /browse GET path by ~70x. The
// ctx-based shape is safe under concurrent requests and costs
// the race detector nothing.
templ Layout(title string, omitJobsOverlay ...bool) {
	<!DOCTYPE html>
	// lang is hard-coded to "en" for now. DixieData may be used by
	// researchers working with Spanish / French / German Civil War
	// materials; full UI localisation is tracked separately and will
	// surface the lang attribute from a user preference when it lands.
	<html lang="en" data-theme={ layoutTheme(ctx) }>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } — DixieData</title>
		<script>
			(() => {
				const root = document.documentElement;
				const storageKey = "dixiedata.layout.mode";
				const breakpoint = 1000;
				let preference = "auto";
				try {
					const raw = window.localStorage.getItem(storageKey);
					if (raw) {
						const parsed = JSON.parse(raw);
						if (parsed === "relaxed" || parsed === "split-screen") {
							preference = parsed;
						}
					}
				} catch (error) {
					preference = "auto";
				}
				const mode = preference === "auto"
					? (window.innerWidth <= breakpoint ? "split-screen" : "relaxed")
					: preference;
				root.setAttribute("data-layout-mode", mode);
				root.setAttribute("data-layout-mode-preference", preference);
			})();
		</script>
		<link rel="stylesheet" href="/app.css"/>
		// Issue #309: expose debug-mode state to the JS layer
		// so the dev badge can unhide itself and the toolbox's
		// install routine can skip in production builds.
		// debug.IsDebugMode(ctx) returns true only when the
		// appshell requested debug mode via the per-request
		// context (or the debug launcher's DIXIEDATA_DEBUG=1).
		//
		// NB: templ uses {{ value }} (double braces) for JS
		// interpolation inside <script> blocks -- NOT the
		// single-brace Go expression syntax that works in
		// HTML attributes. Single braces inside <script> are
		// emitted verbatim, which would break the JS at parse
		// time. Bug surfaced in issue #309 follow-up after the
		// make-debug launcher env-fix (commit e3eb552) didn't
		// surface the badge.
		<script>
			window.DIXIEDATA_DEVTOOLS = {{ debug.IsDebugMode(ctx) }};
		</script>
		<script defer src="/debug.js"></script>
		<script defer src="/debug-toolbox.js"></script>
		<script defer src="/htmx.min.js"></script>
		<script defer src="/app.js"></script>
		<!-- CSS moved to frontend/tailwind.css by PR1. -->
	</head>
		<body class="min-h-screen" data-layout-mode="relaxed" data-layout-mode-preference="auto" data-dixie-page={ layoutCurrentPath(ctx) }>
			<div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>
			if len(omitJobsOverlay) == 0 || !omitJobsOverlay[0] {
				// Floating popup that shows the most-recent active
				// background job's progress card. Polled via /jobs/active
				// every 3s. Suppressed when the current page already
				// shows that job's progress inline (the /jobs/{id}
				// status page) so the same data doesn't render twice.
				<div class="jobs-progress-overlay" data-jobs-progress-region { htmxattr.Mux{
					Get:     routebuilder.ActiveJobs(),
					Swap:    "innerHTML",
					Trigger: "load, every 3s",
				}.Attrs()... }></div>
			}
			<div class="app-shell">
				<header class="top-shell flex flex-wrap items-center justify-between gap-3 rounded-[1.7rem] border border-[var(--theme-accent-strong)] bg-[rgb(var(--theme-ink-deep-rgb)/0.92)] px-5 py-3 shadow-[0_20px_40px_rgba(21,29,38,0.2)] backdrop-blur">
				<div class="flex items-center gap-3">
					<p class="top-brand-title gold leading-none">DixieData — <em>{ buildinfo.Codename() }</em></p>
				</div>
				<nav class="flex flex-wrap items-center gap-2">
					<a href="/calendar" class="pill-link top-nav-link">Calendar</a>
					// Issue #380 slice 2: Records mega-menu (2D panel,
					// NN/g mega-menus-work-well pattern) collapses the
					// 5 flat pills that used to live here -
					// Search/Browse/Events/Articles/Tags - into one
					// 2D panel with two groups. Issue #471 moved
					// Browse into the People column (it's the primary
					// Person Record navigation surface) and Events
					// into the More records column (alongside
					// Articles). Tags followed in the same pass —
					// moved out of the People column into the More
					// records column so the People group stays the
					// surface-navigation pair (Search + Filter) and
					// More records collects the secondary listing
					// surfaces (Tags, Articles, Events). The
					// pre-mega-menu data-* hooks survive inside the
					// panel (data-marker) so audit/smoke.mjs +
					// analytics selectors stay stable. Each item is
					// a real <a role="menuitem" href> for screen
					// readers + middle-click + htmx compatibility.
					// The "Search" item uses the new label (slice
					// 5); URL stays /soldiers.
					// The "Filter" item is the UI label for the
					// legacy /browse route (handler: handleBrowse,
					// service: records.BrowsePage). See issue #503.
					@components.MegaMenu("Records", uiids.LayoutRecordsMenu, nil, []components.MegaGroup{
						{
							Title: "People",
							Items: []templ.Component{
								templ.Raw(`<li role="none"><a href="/soldiers" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-marker="records-search">Search</a></li>`),
								templ.Raw(`<li role="none"><a href="/browse" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-marker="records-browse">Filter</a></li>`),
							},
						},
						{
							Title: "More records",
							Items: []templ.Component{
								templ.Raw(`<li role="none"><a href="/tags" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-marker="records-tags">Tags</a></li>`),
								templ.Raw(`<li role="none"><a href="/articles" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-marker="records-articles">Articles</a></li>`),
								templ.Raw(`<li role="none"><a href="/events" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-marker="records-events">Events</a></li>`),
							},
						},
					})
					// Issue #380 slice 3 absorbed Insights into
					// the Share & Review mega-menu's "Review &
					// Research" column. No top-nav pill needed.
					// Issue #380 slice 3: Share & Review mega-menu (2D
					// panel, NN/g mega-menus-work-well pattern)
					// absorbs the 2 prior foldouts (Research & Review
					// + Share) + the standalone Insights pill into
					// one 2D panel with 2 columns. The live-count
					// badge wire (issue #455 slice 1.5) moves from
					// the old R&R foldout trigger onto the new
					// mega-menu trigger button; the wire shape (span
					// + hx-get + hx-trigger + hx-swap + hx-target=
					// "this") is byte-identical.
					@components.MegaMenuWithBadge("Share & Review", uiids.LayoutShareReviewMenu, nil, templ.Raw(`<span data-layout-research-review-count hx-get="`+routebuilder.LayoutReviewCount()+`" hx-trigger="load, every 30s" hx-swap="innerHTML" hx-target="this" hx-ext="none"></span>`), []components.MegaGroup{
						// Column 1: Review & Research. The 5 items mirror
						// the pre-#380 R&R foldout (issue #378 slice 2)
						// + the standalone Insights pill that used to
						// live to the left of the foldout.
						{
							Title: "Review & Research",
							Items: []templ.Component{
								// Review Queue menuitem: keeps the open-count
								// flag echo logic (issue #460). When the
								// /layout/review-count poll reports >0, the
								// menuitem gains data-research-review-has-count
								// + the red border classes. The badge in the
								// trigger button is the JS wire; this menuitem
								// flag is the server-rendered echo.
								templ.Raw(reviewQueueMenuItem(layoutHasOpenReview(ctx))),
								// Issue #491: Archive Inventory menuitem. Lives
								// in the Review & Research group because it
								// answers the same "what's in my archive"
								// question the picker answers for Person
								// Records, just at a basic level than the
								// per-attribute Insights analytics.
								templ.Raw(`<li role="none"><a href="` + routebuilder.Inventory() + `" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-research-menu-inventory>Archive Inventory</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ResearchPicker() + `?next=timeline" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-research-menu-timeline>Open Timeline</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ResearchPicker() + `?next=research-log" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-research-menu-research-log>Open Research Log</a></li>`),
								templ.Raw(`<li role="none"><a href="/research-collections" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-research-menu-research-collections>Research Collections</a></li>`),
								templ.Raw(`<li role="none"><a href="/research" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-research-menu-change-person>Change Person…</a></li>`),
								templ.Raw(`<li role="none"><a href="/insights" role="menuitem" class="mega-menu-item pill-link justify-start w-full">Insights</a></li>`),
							},
						},
						// Column 2: Share. /share (Landing) is the NEW
						// first item -- closes the /share vs
						// /share/exports asymmetry footgun that was
						// a discussion point in #380 Phase 1.
						{
							Title: "Share",
							Items: []templ.Component{
								templ.Raw(`<li role="none"><a href="/share" role="menuitem" class="mega-menu-item pill-link justify-start w-full">Share landing</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ShareExports() + `" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-share-menu-export>Export</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ShareImports() + `" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-share-menu-import>Import</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ShareQueuePage() + `" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-share-queue-page-link>Share Queue</a></li>`),
								templ.Raw(`<li role="none"><a href="` + routebuilder.ShareSync() + `" role="menuitem" class="mega-menu-item pill-link justify-start w-full" data-share-menu-sync>Sync</a></li>`),
							},
						},
					})
					<a href="/settings" class="pill-link top-nav-link">Settings</a>
					<a href="/soldiers/new" class="primary-button top-nav-primary">Add Person Record</a>
				</nav>
			</header>
			// Issue #309: always-visible breadcrumb trail. The
			// dev badge + JS toolbox are witnesses for the same
			// current-page fact (see breadcrumbs/comment near the
			// toolbox); if this and the dev badge disagree, layout
			// is broken. The breadcrumb renders both server-side
			// (initial paint, no flash) and JS-updates on htmx
			// swap via the same path-resolution helper the toolbox
			// ports to JS.
			@components.Breadcrumb(layoutCurrentPath(ctx))
			<main>
				{ children... }
			</main>
			<div class="floating-dock fixed inset-x-0 bottom-0 z-40">
				<div class="floating-dock-inner flex items-center justify-end gap-3 pl-4 pr-0 py-3 sm:pl-6 sm:pr-0">
					<p data-floating-scratchpad-status class="mr-auto text-xs text-slate-300" aria-live="polite"></p>
					@components.Button("Scratch Pad", components.ButtonSecondary, "floating-dock-button", templ.Attributes{"data-scratchpad-open": ""})
					@components.Button("Feedback", components.ButtonSecondary, "floating-dock-button", templ.Attributes{"data-feedback-open": ""})
					@components.Button("Menu", components.ButtonPrimary, "floating-dock-button", templ.Attributes{"data-floating-nav-toggle": ""})
				</div>
				<!-- Issue #182: persistent Share Queue status pill.
			     Lives outside the floating dock per the spec (no
			     z-index collision with the recent overlay fix).
			     Hidden when the queue is empty so the layout stays
			     quiet for users who never touched the queue. -->
			<a href={ templ.SafeURL(routebuilder.ShareQueuePage()) } data-share-queue-pill class="fixed bottom-[6.5rem] left-1/2 z-30 hidden -translate-x-1/2 rounded-full border border-[var(--theme-accent-strong)] bg-[rgb(var(--theme-ink-deep-rgb)/0.96)] px-5 py-2 text-sm font-semibold text-[var(--theme-accent-glow)] shadow-[0_18px_32px_rgba(23,33,43,0.28)] hover:bg-[rgb(var(--theme-ink-deep-rgb)/1)]">
				<span data-share-queue-pill-label>Share queue:</span>
				<span data-share-queue-pill-count class="ml-2 rounded-full bg-[var(--theme-accent-strong)] px-2 py-0.5 text-xs font-mono">0</span>
				<span class="ml-3 text-xs uppercase tracking-[0.18em] text-[var(--theme-sepia-300)]">Review &amp; export</span>
			</a>
			<div data-floating-nav-panel class="floating-nav-panel fixed bottom-[5.5rem] right-4 z-50 hidden w-[24rem] max-w-[calc(100vw-2rem)] min-w-[15rem] rounded-[1.5rem] border border-[var(--theme-accent-strong)] bg-[rgb(var(--theme-ink-deep-rgb)/0.96)] p-4 shadow-[0_24px_44px_rgba(23,33,43,0.28)] sm:right-6">
					<p class="text-xs uppercase tracking-[0.28em] text-[var(--theme-sepia-300)]">Quick Navigation</p>
					<nav class="mt-3 flex flex-col gap-2">
						// Issue #380 OQ4 lock (slice 4): the floating-dock
						// Quick Nav panel mirrors the top-nav's flat pills
						// (Calendar / Settings / + Add Person Record) +
						// the first item of each mega-menu (Search from
						// Records; Share landing from Share & Review).
						// Foldouts + mega-menus stay top-nav exclusive --
						// the dock is a flat list of nav destinations,
						// not a nav primitive itself.
						<a href="/calendar" class="pill-link justify-start">Calendar</a>
						<a href="/soldiers" class="pill-link justify-start">Search</a>
						<a href="/share" class="pill-link justify-start">Share landing</a>
						<a href="/settings" class="pill-link justify-start">Settings</a>
						<a href="/soldiers/new" class="primary-button justify-start">Add Person Record</a>
					</nav>
					<div class="mt-4 rounded-[1.2rem] border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgba(255,248,230,0.08)] p-3">
						<p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--theme-sepia-300)]">Layout Mode</p>
						<p class="layout-mode-summary mt-2 text-sm text-slate-200">
							Current: <strong data-layout-mode-status>Relaxed</strong>
							<span class="text-xs uppercase tracking-[0.18em] text-slate-400" data-layout-mode-preference-label>Auto</span>
						</p>
						<p class="mt-2 text-xs leading-5 text-slate-300">Auto switches to split-screen around <span data-layout-mode-breakpoint>1000px</span>.</p>
						<div class="mt-3 flex flex-col gap-2">
							<button type="button" data-layout-mode-option="auto" data-layout-mode-active="true" class="layout-mode-option secondary-button">
								<span>Auto</span>
								<span class="text-[0.65rem] uppercase tracking-[0.18em]">Adaptive</span>
							</button>
							<button type="button" data-layout-mode-option="relaxed" data-layout-mode-active="false" class="layout-mode-option secondary-button">
								<span>Relaxed</span>
								<span class="text-[0.65rem] uppercase tracking-[0.18em]">Roomier</span>
							</button>
							<button type="button" data-layout-mode-option="split-screen" data-layout-mode-active="false" class="layout-mode-option secondary-button">
								<span>Split-screen</span>
								<span class="text-[0.65rem] uppercase tracking-[0.18em]">Compact</span>
							</button>
						</div>
					</div>
				</div>
			</div>
			<div id="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="feedback-modal-heading" data-feedback-modal class="fixed inset-0 z-[90] hidden items-start justify-center overflow-y-auto bg-[rgba(15,23,42,0.58)] px-4 py-4 sm:items-center sm:py-8">
				<div class="relative w-full max-w-2xl max-h-[calc(100vh-2rem)] overflow-y-auto rounded-[2rem] border border-[rgb(var(--theme-sepia-rgb)/0.8)] bg-[rgb(var(--theme-parchment-rgb)/0.98)] p-6 shadow-[0_24px_60px_rgba(15,23,42,0.35)] sm:max-h-[calc(100vh-4rem)] sm:p-7">
					<form id="feedback-form" action={ templ.SafeURL(routebuilder.FeedbackSubmit()) } method="post" data-dixie-submit class="space-y-6">
						<input type="hidden" name="page_path" value="" data-feedback-page-path/>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.26em] text-[var(--theme-accent-strong)]">Feedback</p>
								<h3 id="feedback-modal-heading" class="mt-2 text-xl gold font-bold">Send app feedback</h3>
								<p class="mt-2 text-sm text-slate-600">Save bugs, workflow pain points, or feature ideas to the local feedback log without leaving your current screen.</p>
							</div>
							@components.Button("Close", components.ButtonSecondary, "w-full px-4 sm:w-auto", templ.Attributes{
								"data-feedback-close": "",
							})
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<label class="block text-sm text-slate-700">
								Category
								<select name="category" class="field-input mt-2">
									<option value="bug">Bug</option>
									<option value="feature">Feature Request</option>
									<option value="research">Research Workflow</option>
									<option value="general">General Feedback</option>
								</select>
							</label>
							<label class="block text-sm text-slate-700">
								Name or initials
								<input type="text" name="contact_name" class="field-input mt-2" placeholder="Optional"/>
							</label>
						</div>
						<label class="block text-sm text-slate-700">
							Email
							<input type="email" name="contact_email" class="field-input mt-2" placeholder="Optional"/>
						</label>
						<label class="block text-sm text-slate-700">
							Message
							<textarea name="message" rows="4" class="field-input mt-2 min-h-32" placeholder="What happened, what you expected, or what feature would help?" required aria-required="true"></textarea>
						</label>
						<p class="text-xs leading-6 text-slate-500">Use Share → Support &amp; Diagnostics to export the feedback log for email attachments.</p>
						<div class="flex flex-col-reverse gap-3 sm:flex-row sm:flex-wrap sm:justify-end">
							@components.Button("Cancel", components.ButtonSecondary, "w-full sm:w-auto", templ.Attributes{
								"data-feedback-close": "",
							})
							@components.Button("Save Feedback", components.ButtonPrimary, "w-full sm:w-auto", templ.Attributes{"type": "submit"})
						</div>
					</form>
				</div>
			</div>
			<footer class="mt-8 text-right text-xs text-slate-600" data-build-identity={ buildinfo.BuildIdentity() }>
				{ buildinfo.AppLabel() } — <em>{ buildinfo.Codename() }</em> · Schema v{ fmt.Sprintf("%d", buildinfo.SchemaVersion) } · { buildinfo.BuildIdentity() }
				if debug.IsDebugMode(ctx) {
					<button type="button"
						class="ml-3 rounded bg-amber-500 px-3 py-1 text-xs font-semibold text-white hover:bg-amber-600"
						{ htmxattr.Mux{
							Get:    routebuilder.DebugConsole(),
							Target: "body",
							Swap:   "beforeend",
						}.Attrs()... }
						data-debug-button>
						🐞 Debug
					</button>
				}
			</footer>
			// Issue #309: floating dev badge (bottom-right).
			// Hidden by default; installDevPageBadge() in app.js
			// removes the `hidden` class once it confirms
			// window.DIXIEDATA_DEVTOOLS === true. Production
			// users never see this; the debug launcher's
			// DIXIEDATA_DEVTOOLS=1 env var is the gate.
			if debug.IsDebugMode(ctx) {
				@components.DevPageBadge(layoutCurrentPath(ctx))
			}
		</div>
	</body>
	</html>
}
