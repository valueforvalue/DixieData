// Event Record panel fragments (issue #320 follow-up, issue
// #341, issue #320 child #332). The Sources, Tags, and Images
// sections on event_detail.templ are swapped in-place by the
// JS dispatcher when the user attaches / detaches / imports /
// deletes. To keep the page render and the fragment-return
// render in lock-step, both contexts call the helpers in this
// file.
//
// The helpers accept viewmodel.SourceRecord, viewmodel.TagOption,
// and viewmodel.Image slices plus the parent event id so the
// action URLs are constructed the same way. The handlers in
// internal/appshell/events_handlers.go Render these helpers
// after each write (attach / detach / delete) and write the
// resulting HTML into the matching #data-event-sources-list /
// #data-event-tags-list / #data-event-images-list div via
// data-results-target.
//
// Style mirrors event_detail.templ exactly so the swap is
// visually identical to the initial page render.
//
// EventSectionPanel (issue #343 finding #2) extracts the
// near-identical Sources + Tags scaffolding from
// event_detail.templ so future panel-shape changes (header
// polish, CTA reorder) land in one place instead of N copies.
// Scope is intentionally narrow: Sources + Tags only. The
// Linked Persons panel has no body wrapper div + the Images
// panel has no Edit CTA + a tail import form; either pattern
// would need a wider param set or a follow-up slice, so they
// stay inline for now per the issue's "apply opportunistically"
// recommendation.
package templates

import (
	"fmt"
	"github.com/valueforvalue/DixieData/internal/persondisplay"
	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/uiids"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

// EventSourcesListFragment renders the per-Event Sources list
// (rows or empty state) for both the initial page render and
// the post-attach / post-detach fragment swap. When sources is
// empty, the EmptyState card matches the on-page copy exactly.
// Issue #340 / v61: sources come from the new EventSources
// viewmodel field, which mirrors models.Soldier.EventSources
// (populated by EventService.GetEventByID from the
// event_sources table).
templ EventSourcesListFragment(eventID int64, sources []viewmodel.SourceRecord) {
	if len(sources) == 0 {
		@components.EmptyState("No Source Records attached", "Add sources from the event editor — open Edit Event, paste your source rows, save.", "")
	} else {
		<ol class="space-y-2" data-event-sources-list>
			for i, src := range sources {
				<li class="rounded-2xl border border-slate-200 bg-white/70 p-3 text-sm" data-event-source-id={ fmt.Sprintf("%d", src.ID) }>
					<div class="flex flex-wrap items-center gap-2">
						<div class="flex-1 min-w-0">
							<span class="font-mono text-xs text-slate-500">{ src.AppID }</span>
							<span class="ml-2 font-semibold">{ src.SourceRecordType }</span>
							<p class="mt-1 whitespace-pre-line text-xs text-slate-600">{ src.Details }</p>
						</div>
						<div class="flex items-center gap-1 shrink-0">
							<form
								method="patch"
								action={ templ.SafeURL(routebuilder.EventSourcePosition(eventID, src.ID)) }
								data-dixie-submit="true"
								data-reload-on-success="true"
								class="inline"
							>
								<input type="hidden" name="position" value={ fmt.Sprintf("%d", i) }/>
								<button
									type="submit"
									class="icon-link"
									if i == 0 {
										disabled
									}
									aria-label="Move up"
									data-event-source-move="up"
									data-event-source-id={ fmt.Sprintf("%d", src.ID) }
								>▲</button>
							</form>
							<form
								method="patch"
								action={ templ.SafeURL(routebuilder.EventSourcePosition(eventID, src.ID)) }
								data-dixie-submit="true"
								data-reload-on-success="true"
								class="inline"
							>
								<input
									type="number"
									name="position"
									value={ fmt.Sprintf("%d", i+1) }
									min="1"
									max={ fmt.Sprintf("%d", len(sources)) }
									class="w-14 rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.6)] px-2 py-1 text-center text-xs text-[color:var(--ink)]"
									data-event-source-position
									data-event-source-id={ fmt.Sprintf("%d", src.ID) }
								/>
							</form>
							<form
								method="patch"
								action={ templ.SafeURL(routebuilder.EventSourcePosition(eventID, src.ID)) }
								data-dixie-submit="true"
								data-reload-on-success="true"
								class="inline"
							>
								<input type="hidden" name="position" value={ fmt.Sprintf("%d", i+2) }/>
								<button
									type="submit"
									class="icon-link"
									if i == len(sources)-1 {
										disabled
									}
									aria-label="Move down"
									data-event-source-move="down"
									data-event-source-id={ fmt.Sprintf("%d", src.ID) }
								>▼</button>
							</form>
						</div>
					</div>
				</li>
			}
		</ol>
	}
}

// EventTagsListFragment renders the per-Event Tags chips (or
// empty state) for both the initial page render and the
// post-detach fragment swap. The detach buttons carry
// data-results-target="#data-event-tags-list" so the next click
// re-renders this fragment in place.
templ EventTagsListFragment(eventID int64, tags []viewmodel.TagOption) {
	if len(tags) == 0 {
		@components.EmptyState("No tags attached", "Add tags to group this Event with related Person Records.", "")
	} else {
		<div class="flex flex-wrap gap-2">
			for _, tag := range tags {
				<span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1 text-xs">
					<span class="font-semibold">{ tag.Name }</span>
					<button
						type="button"
						data-action={ templ.SafeURL(routebuilder.EventTagDetach(eventID, tag.ID)) }
						data-dixie-submit="true"
						data-results-target="#data-event-tags-list"
						class="ghost-link text-slate-500 hover:text-red-700"
					>&times;</button>
				</span>
			}
		</div>
	}
}

// EventImagesListFragment (issue #320 child #332, slot 16 of 16)
// renders the per-Event Images gallery (grid of cards or empty
// state) for both the initial page render on event_detail.templ
// and the post-delete fragment swap. Each card carries the
// thumbnail (via the existing imageURL helper), the caption,
// the file name, and a delete button posting to
// /events/{id}/images/delete with the image_id; the delete
// button's data-results-target keeps the next render in lock
// step with the initial page render (no X-DixieData-Redirect,
// per issue #341). Storage path is the same sharded
// images/<A>/<B>/EVT-NNNNN/ layout the v60 widening enabled
// for every Person Record subtype.
templ EventImagesListFragment(eventID int64, images []viewmodel.Image) {
	if len(images) == 0 {
		@components.EmptyState("No images are attached", "Use the Add Images From Computer button below to import one or more files with the desktop file picker.", "")
	} else {
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			for _, img := range images {
				<div data-image-card data-image-id={ fmt.Sprintf("%d", img.ID) } class="card rounded-2xl p-3">
					<div class="mb-3 flex flex-wrap items-start justify-between gap-2">
						<span class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">Image</span>
						<form
							action={ templ.SafeURL(fmt.Sprintf("/events/%d/images/delete", eventID)) }
							method="post"
							data-image-delete-form="true"
							data-dixie-submit="true"
							data-confirm="Delete this image?"
							data-results-target={ "#" + uiids.PanelEventDetailImages }
							class="inline"
						>
							<input type="hidden" name="image_ids" value={ fmt.Sprintf("%d", img.ID) }/>
							<button type="submit" class="pill-link">Delete</button>
						</form>
					</div>
					<img src={ imageURL(img.FilePath) } data-image-thumb-id={ fmt.Sprintf("%d", img.ID) } alt={ imageAltText(img.Caption, fmt.Sprintf("EVT-%s", img.PersonRecordSyncID)) }
						class="mb-3 h-40 w-full rounded-xl bg-slate-50 object-contain"/>
					<div class="text-sm gold font-medium">{ img.Caption }</div>
					<div class="text-xs text-slate-500 break-all">{ img.FileName }</div>
				</div>
			}
		</div>
	}
}
// EventLinksListFragment (issue #361 slice 2) renders the
// per-Event Linked Person Records rows (or empty state) for
// the Event editor's inline link/unlink surface. Each linked
// Person carries a pill-link to /soldiers/{id} (the Person
// detail page) plus an Unlink button posting to
// /events/{id}/links/{personId}/detach. Per the slice-2
// decision, the handler returns X-DixieData-Redirect (full
// page nav back to /events/{id}/edit) rather than an in-place
// fragment swap — this matches the Person Events tab attach
// pattern (/soldiers/{id}/events/...) and avoids a fragment
// ID + swap target that no longer exists on the edit page.
templ EventLinksListFragment(eventID int64, linked []viewmodel.PersonRecord) {
	if len(linked) == 0 {
		@components.EmptyState("No linked Person Records", "Add a Person Record by Display ID below — type DXD-NNNNN and submit.", "")
	} else {
		<ul class="space-y-2" data-event-links-list>
			for _, person := range linked {
				<li class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/70 p-3 text-sm">
					<a href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d", person.ID)) } class="pill-link">{ person.DisplayID }</a>
					<span class="text-sm text-slate-700">{ persondisplay.FullName(persondisplay.NameParts{
						Prefix:               person.Prefix,
						ShowPrefixBeforeName: person.ShowPrefixBeforeName,
						FirstName:            person.FirstName,
						MiddleName:           person.MiddleName,
						LastName:             person.LastName,
						Suffix:               person.Suffix,
					}) }</span>
					<button
						type="button"
						data-action={ templ.SafeURL(routebuilder.EventLinksDetach(eventID, person.ID)) }
						data-dixie-submit="true"
						class="ghost-link text-red-700 hover:text-red-900"
					>Unlink</button>
				</li>
			}
		</ul>
	}
}

// EventSectionPanel renders one section on the Event detail
// page with the standard header (title + count + Edit Event
// CTA) and a body wrapper div carrying the literal id the JS
// dispatcher swaps into. Extracted from event_detail.templ to
// pin the Sources + Tags panel shape in one place (issue #343
// finding #2).
//
// Parameters:
//   - title:    the uppercase-tracking section label
//     (e.g. "Source Records", "Tags").
//   - count:    the integer that follows the section label
//     (e.g. len(event.EventSources), len(event.Tags)).
//   - countFmt: the lowercase word after the count
//     (e.g. "attached"). Rendered as "{count} {countFmt}".
//   - eventID:  the parent Event id. Used to wire the Edit
//     Event CTA to /events/{eventID}/edit.
//   - panelID:  the literal id on the body wrapper div. The
//     JS dispatcher uses this exact id as the swap target;
//     do not change it without updating the matching
//     appshell/events_handlers.go data-results-target.
//   - body:     the panel body content (typically a list/empty
//     fragment like EventSourcesListFragment).
//
// The header layout and class lists mirror the inline shape
// from event_detail.templ:114-131 (Sources) + 133-148 (Tags)
// byte-for-byte, so the existing appshell/events_handlers_test.go
// substring pins (id="data-event-sources-list", Edit Event
// data-action) keep passing without modification.
templ EventSectionPanel(
	title string,
	count int,
	countFmt string,
	eventID string,
	panelID string,
	body templ.Component,
) {
	<section class="relative mt-6">
		<div class="mb-3 flex flex-wrap items-center justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-[0.26em] text-[#8d7440]">{ title }</p>
			<div class="flex items-center gap-3">
				<span class="text-xs text-slate-500">{ fmt.Sprintf("%d %s", count, countFmt) }</span>
				<button
					type="button"
					data-action={ templ.SafeURL(fmt.Sprintf("/events/%s/edit", eventID)) }
					data-dixie-submit="true"
					class="ghost-link"
				>Edit Event</button>
			</div>
		</div>
		<div id={ panelID }>
			@body
		</div>
	</section>
}
