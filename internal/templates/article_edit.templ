// article_edit.templ — v62 (issue #321 slice 3.5 + 3.7)
// edit-Article form. Slice 3.5 shipped the minimum form
// (title + subtitle + body) so the route + handler tests
// could pin the round-trip + 404 + 400 + 409 contracts.
// Slice 3.7 swaps the body textarea for the same markdown
// editor + sanitized live preview + local-draft-persistence
// block landed in slice 3.6 (ArticleArticleForm).
//
// The slice-3.7 surface uses the same data-draft-key +
// data-record-persistence attrs as entry_form.templ so the
// JS initializeDraftForms() helper auto-wires the
// localStorage persistence for the edit-side draft.
//
// The back-link is rendered inside ArticleArticleForm
// (issue #375 fix); this file exists only as the thin
// route-handler shell wrapper around the shared form.
package templates

import "github.com/valueforvalue/DixieData/internal/viewmodel"

templ ArticleEditShell(view viewmodel.Article) {
	@ArticleArticleForm(view, true)
}