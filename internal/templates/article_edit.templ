// article_edit.templ — v62 (issue #321 slice 3.5 + 3.7)
// edit-Article form. Slice 3.5 shipped the minimum form
// (title + subtitle + body) so the route + handler tests
// could pin the round-trip + 404 + 400 + 409 contracts.
// Slice 3.7 swaps the body textarea for the same markdown
// editor + sanitized live preview + local-draft-persistence
// block landed in slice 3.6 (ArticleArticleForm).
//
// The slice-3.7 surface uses the same data-draft-key +
// data-record-persistence attrs as entry_form.templ so the
// JS initializeDraftForms() helper auto-wires the
// localStorage persistence for the edit-side draft.
package templates

import (
	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ ArticleEditShell(view viewmodel.Article) {
	@ArticleArticleForm(view, true)
}

// articleEditBackURL is the URL the "← Back" button on
// the edit form navigates to. It is a helper so the form
// does not couple directly to routebuilder beyond the
// shared action + list helpers in ArticleArticleForm.
func articleEditBackURL(article viewmodel.Article) templ.SafeURL {
	return templ.SafeURL(routebuilder.ArticleByID(article.ID))
}

// ensureBackButtonComponent pulls components.Button into
// the import set without binding a real reference here
// -- the back-link is rendered inside ArticleArticleForm
// already; this helper exists so future slice-3.x edits
// to article_edit.templ have a place to drop component
// references without re-deriving the import list.
var _ = components.Button