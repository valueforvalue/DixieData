// person_events_tab.templ — lazy-loaded fragment for the Person
// Record → Events tab (issue #320 slice #324 + slice #325). The
// route handler (handlePersonEventsTab) renders this fragment;
// soldier_card.templ uses hx-get to fetch the response and swap
// innerHTML.
//
// slice #325 added the Attach / Quick-add / Unlink controls on
// top of the slice-324 fragment:
//   - inline "Unlink" form per linked Event row → POSTs to
//     routebuilder.PersonEventDetach
//   - "Add existing event" <details> with a Display-ID input
//     → POSTs to /soldiers/{id}/events/{eventId}/attach (see routes.go); the handler
//     resolves Event by Display ID via events.GetEventByDisplayID
//   - "Quick add new event" <details> with kind + begin/end +
//     description → POSTs to routebuilder.PersonEventQuickAdd;
//     the handler calls parseEventForm → events.CreateEvent
//     → events.AttachEventToPerson
//
// The Attach/Quick-add forms mirror the tags block style
// already proven in soldier_card.templ (data-dixie-submit +
// data-reload-on-success). Empty-state copy steers the
// researcher toward the new controls.
package templates

import (
	"fmt"
	"strings"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ PersonEventsTab(personID int64, linked []viewmodel.EventRecord) {
	<div class="space-y-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-accent-strong)]">Event Records</p>
			<span class="text-xs text-slate-500">{ fmt.Sprintf("%d linked", len(linked)) }</span>
		</div>
		if len(linked) == 0 {
			<p class="rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm text-slate-600">
				No Event Records are linked to this Person Record yet. Open <strong>Add existing event</strong> below to attach an Event by its Display ID, or <strong>Quick add new event</strong> to mint one in place.
			</p>
		} else {
			<ul class="space-y-2">
				for _, event := range linked {
					<li class="rounded-2xl border border-slate-200 bg-white/70 p-3 text-sm">
						<div class="flex flex-wrap items-baseline justify-between gap-2">
							<a href={ templ.SafeURL(routebuilder.EventDetail(event.ID)) } class="pill-link">
								{ strings.TrimSpace(event.DisplayID) }
							</a>
							if strings.TrimSpace(event.Kind) != "" {
								<span class="rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.4)] bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-accent-strong)]">
									{ event.Kind }
								</span>
							}
							if event.BeginDate != "" || event.EndDate != "" {
								<span class="text-xs text-slate-500">
									{ eventDateRange(event) }
								</span>
							}
						</div>
						<form action={ templ.SafeURL(routebuilder.PersonEventDetach(personID, event.ID)) } method="post" data-dixie-submit="true" data-reload-on-success="true" class="mt-2 flex justify-end">
							<button type="submit" class="inline-flex items-center rounded-full border border-[var(--theme-review-red)]/40 bg-white/70 px-3 py-1 text-xs font-semibold text-[var(--theme-review-red)] hover:bg-[var(--theme-review-red)] hover:text-white" aria-label={ fmt.Sprintf("Unlink event %s from this Person Record", strings.TrimSpace(event.DisplayID)) } title="Unlink">
								Unlink
							</button>
						</form>
					</li>
				}
			</ul>
		}
		<details class="group mt-3 rounded-2xl border border-slate-200 bg-white/70 p-3">
			<summary class="cursor-pointer text-sm font-semibold text-[var(--theme-accent-strong)]">+ Add existing event</summary>
			<form action={ templ.SafeURL(routebuilder.PersonEventAttachByDisplayID(personID)) } method="post" data-dixie-submit="true" data-reload-on-success="true" class="mt-3 flex flex-wrap items-center gap-2">
				<input type="text" name="display_id" placeholder="Event Display ID (e.g. EVT-00001)" class="w-72 rounded border border-slate-300 px-3 py-2 text-sm" required autocomplete="off"/>
				<button type="submit" class="inline-flex items-center rounded-2xl border border-[var(--theme-accent-strong)] bg-[var(--theme-accent-strong)] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#7a6635]">Attach</button>
			</form>
		</details>
		<details class="group mt-2 rounded-2xl border border-slate-200 bg-white/70 p-3">
			<form action={ templ.SafeURL(routebuilder.PersonEventQuickAdd(personID)) } method="post" data-dixie-submit="true" data-reload-on-success="true" class="mt-3 grid gap-2 sm:grid-cols-4">
				<input type="text" name="kind" placeholder="Kind (e.g. Battle)" class="rounded border border-slate-300 px-3 py-2 text-sm sm:col-span-2" required autocomplete="off"/>
				<input type="text" name="begin_date" placeholder="Begin (YYYY-MM-DD)" class="rounded border border-slate-300 px-3 py-2 text-sm" autocomplete="off"/>
				<input type="text" name="end_date" placeholder="End (YYYY-MM-DD)" class="rounded border border-slate-300 px-3 py-2 text-sm" autocomplete="off"/>
				<textarea name="description" placeholder="Description" rows="3" class="rounded border border-slate-300 px-3 py-2 text-sm sm:col-span-4"></textarea>
				<button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl border border-[var(--theme-accent-strong)] bg-[var(--theme-accent-strong)] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#7a6635] sm:col-span-4 sm:w-auto">Create + Link Event</button>
			</form>
		</details>
	</div>
}
