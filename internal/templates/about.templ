// about.templ -- issue #585 slice 4.
//
// Full /about page. Three sections (anchored: #identity, #license,
// #history) plus an in-page nav strip at the top. Anchors use
// plain <a href="#id"> so no JS is required. Section anchors
// are stable URLs (a deep link to /about#license survives a
// page refresh).
//
// Locked copy decisions (issue #585 chat 2026-07-15):
//   - License renders as a 1-paragraph summary + a "View full
//     license" link out to the GitHub LICENSE blob. No inline
//     full text.
//   - Credits render as a minimal list (name + license + one-
//     line purpose). No versions, no URLs (those live in the
//     footer / buildinfo).
//   - Release history: last 10 releases expanded (newest
//     first), older collapsed behind a "show all N releases"
//     toggle. Per-release preview = first 3 bullets of the
//     first non-empty subsection (Added / Changed / Fixed /
//     Maintenance / Documentation in that order); a
//     <details> toggle exposes the rest of that subsection +
//     all other subsections in place. No JS.

package templates

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

// (Issue #598: aboutMaxExpandedReleases + aboutMaxPreviewBullets
// constants removed — the release history section they
// powered is gone.)

templ AboutView(view viewmodel.AboutView) {
	@Layout("About") {
		<div class="relative mx-auto max-w-4xl space-y-6" id="page.about" data-page-about>
			<header class="space-y-2">
				<h1 class="font-display text-3xl font-semibold text-[color:var(--ink)]">About DixieData</h1>
				<p class="text-sm text-slate-600">App identity, license, release history, and repository activity. Built into the binary so it stays accurate even when you are offline.</p>
			</header>
			@aboutInPageNav()
			@aboutIdentitySection(view)
			@aboutLicenseSection(view)
			@aboutGlossarySection(view)
			// Issue #598: aboutHistorySection removed — the
			// recent-commits section (#594) is the replacement
			// for "what just landed."
			@aboutRecentSection(view)
			@aboutActivitySection(view)
		</div>
	}
}

templ aboutInPageNav() {
	<nav aria-label="On this page" class="rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 px-4 py-3 text-sm" data-about-in-page-nav>
		<p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">On this page</p>
		<ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
			<li><a href="#about.identity" class="text-[var(--theme-text-primary)] underline">App identity</a></li>
			<li><a href="#about.license" class="text-[var(--theme-text-primary)] underline">License + credits</a></li>
			<li><a href="#about.glossary" class="text-[var(--theme-text-primary)] underline" data-about-nav-glossary>Glossary</a></li>
			<li><a href="#about.recent" class="text-[var(--theme-text-primary)] underline" data-about-nav-recent>Recent commits</a></li>
			<li><a href="#about.activity" class="text-[var(--theme-text-primary)] underline">Repository activity</a></li>
		</ul>
	</nav>
}

templ aboutIdentitySection(view viewmodel.AboutView) {
	<section class="card rounded-3xl p-5 sm:p-8 space-y-3" id="about.identity" data-about-identity>
		@components.Heading(components.H2, "App identity", "", nil)
		<p class="text-sm text-slate-600">Build-time metadata. The codename is the Southern place-name convention per <code class="font-mono">docs/RELEASING.md</code>; the schema version is the data-plane counter.</p>
		<dl class="grid gap-3 sm:grid-cols-2 text-sm">
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">App</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-app>{ view.AppName }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Version</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-version>{ view.Version }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Codename</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-codename>{ view.Codename }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Schema</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-schema>{ fmt.Sprintf("%d", view.Schema) }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Branch</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-branch>{ view.Branch }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Commit</dt>
				<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-commit>{ view.Commit }</dd>
			</div>
			if view.BuiltAt != "" {
				<div class="sm:col-span-2">
					<dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Built at</dt>
					<dd class="mt-1 font-mono text-[var(--theme-text-primary)]" data-about-built>{ view.BuiltAt }</dd>
				</div>
			}
		</dl>
	</section>
}

templ aboutLicenseSection(view viewmodel.AboutView) {
	<section class="card rounded-3xl p-5 sm:p-8 space-y-3" id="about.license" data-about-license>
		@components.Heading(components.H2, "License + credits", "", nil)
		<div class="space-y-4 text-sm text-slate-700">
			<div data-about-license-summary>
				<p>DixieData is <strong>MIT-licensed</strong> &mdash; free to use, modify, and distribute, with attribution.</p>
				<p class="mt-2">
					<a
						href={ templ.SafeURL(view.LicenseURL) }
						class="text-[var(--theme-text-primary)] underline"
						rel="noopener"
						data-open-external
					>View full license &rarr;</a>
				</p>
			</div>
			<div data-about-credits>
				<h3 class="text-base font-semibold text-[var(--theme-text-primary)]">Credits</h3>
				<p class="text-xs text-slate-500">Binaries the DixieData build actually links. Exact versions live in the footer + buildinfo; this list is the human-readable who-what.</p>
				<ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="pdfium">
						<p class="font-semibold">pdfium</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">Apache 2.0</p>
						<p class="mt-1 text-sm text-slate-600">PDF rendering for Soldier previews.</p>
					</li>
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="typst">
						<p class="font-semibold">Typst</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">Apache 2.0</p>
						<p class="mt-1 text-sm text-slate-600">PDF report generation.</p>
					</li>
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="htmx">
						<p class="font-semibold">htmx</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">BSD-2-Clause</p>
						<p class="mt-1 text-sm text-slate-600">In-page navigation.</p>
					</li>
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="tailwindcss">
						<p class="font-semibold">Tailwind CSS</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">MIT</p>
						<p class="mt-1 text-sm text-slate-600">Styling system.</p>
					</li>
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="playwright">
						<p class="font-semibold">Playwright</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">Apache 2.0</p>
						<p class="mt-1 text-sm text-slate-600">UI audit harness (test-only).</p>
					</li>
					<li class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3" data-about-credit="go-stdlib">
						<p class="font-semibold">Go standard library</p>
						<p class="text-xs uppercase tracking-[0.18em] text-slate-500">BSD-3-Clause</p>
						<p class="mt-1 text-sm text-slate-600">Language runtime.</p>
					</li>
				</ul>
			</div>
		</div>
	</section>
}

// aboutGlossarySection renders the canonical term registry
// (issue #564 slice 1). The section is the full-glossary
// destination for users who land on /about and want the
// project-wide definition list; in-context term mentions
// on Person Record detail, Source Record panel, etc.
// (slice 2) use a disclosure popover that reads the same
// registry's Short field.
//
// Every term renders as a row with a stable kebab anchor
// (#about.glossary-<slug>) the future related-term cross-
// links land on. Sits between License + credits (#license)
// and Recent commits (#recent) per the slice plan's
// narrative flow: "what the app is" → "what the words
// mean" → "what just landed" → "trend data".
templ aboutGlossarySection(view viewmodel.AboutView) {
	<section class="card rounded-3xl p-5 sm:p-8 space-y-4" id="about.glossary" data-about-glossary>
		@components.Heading(components.H2, "Glossary", "", nil)
		<p class="text-sm text-slate-600">
			Canonical domain vocabulary for DixieData. Mirrors <code class="font-mono">CONTEXT.md</code>; if the two drift, the registry wins (and the docs lint should flag the drift). Every term renders with a stable kebab anchor.
		</p>
		if len(view.Glossary) == 0 {
			<p class="text-sm text-amber-700" data-about-glossary-empty>No terms registered.</p>
		} else {
			// Issue #604: bounded height + inner scroll so
			// the glossary does not push the rest of
			// /about down. The 36-term registry renders
			// ~2880px on a baked build; the cap surfaces
			// ~5-6 terms at a glance + the user scrolls
			// for the rest. The empty-state copy ("No
			// terms registered.") sits outside the
			// viewport — it's rare and reads better at
			// full width.
			<div class="max-h-96 overflow-y-auto sm:max-h-[32rem]">
				<dl class="space-y-3" data-about-glossary-list>
					for _, entry := range view.Glossary {
						@aboutGlossaryRow(entry)
					}
				</dl>
			</div>
		}
	</section>
}

// bake) the empty-state copy renders.
//
// Sits between License + credits (#license) and Repository
// activity (#activity). The narrative flow is "what the
// app is" → "what just landed" → "trend data". (Issue #598
// removed the Release history section that used to sit
// between License and Recent commits.)
templ aboutRecentSection(view viewmodel.AboutView) {
	<section class="card rounded-3xl p-5 sm:p-8 space-y-4" id="about.recent" data-about-recent>
		@components.Heading(components.H2, "Recent commits", "", nil)
		<p class="text-sm text-slate-600">The most recent commits to the <code class="font-mono">dev</code> branch, baked at release time. Click a row to open the commit on GitHub. Commits within the last 30 days render a relative date; older commits fall back to the ISO date.</p>
		if len(view.RecentCommits) == 0 {
			<div class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgb(var(--theme-amber-100-rgb)/0.6)] p-4 text-sm text-amber-950" data-about-recent-empty>
				Recent commits will appear after the next build. The bake captures the last 25 commits to the <code class="font-mono">dev</code> branch; run <code class="font-mono">make tpl</code> to refresh.
			</div>
		} else {
			@aboutRecentList(view.RecentCommits)
		}
	</section>
}

// aboutRecentList renders the per-commit rows. Newest first
// (the bake-script's git-log default). Each row links to
// the GitHub commit permalink; the short hash is the visible
// link text. The full hash is also rendered (visually muted)
// so a user can copy-paste it from the page source.
templ aboutRecentList(commits []viewmodel.RecentCommitView) {
	// Issue #603: bounded height + inner scroll so
	// the list does not push the rest of /about down
	// when the build carries many baked commits. The
	// cap is 24rem on small screens / 32rem on `sm:`
	// so 6-7 commits stay visible before scrolling.
	<div class="max-h-96 overflow-y-auto sm:max-h-[32rem]">
		<ul class="divide-y divide-[rgb(var(--theme-sepia-rgb)/0.25)]" data-about-recent-list>
			for _, c := range commits {
				<li class="py-2.5 text-sm" data-about-recent-row={ c.Hash }>
					<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<a
						href={ templ.URL("https://github.com/valueforvalue/DixieData/commit/" + c.Hash) }
						class="font-mono text-[var(--theme-text-primary)] underline shrink-0"
						data-about-recent-hash
						data-short-hash={ c.ShortHash }
					>{ c.ShortHash }</a>
					<span class="text-xs text-slate-500 shrink-0" data-about-recent-date>{ c.Date }</span>
					<span class="text-xs text-slate-600 shrink-0" data-about-recent-author>{ c.Author }</span>
					<a
						href={ templ.URL("https://github.com/valueforvalue/DixieData/commit/" + c.Hash) }
						class="grow text-[var(--theme-text-primary)] hover:underline"
						data-about-recent-subject
					>{ c.Subject }</a>
				</div>
			</li>
		}
		</ul>
	</div>
}

// aboutActivitySection renders the Repository activity
// section (anchored #activity). When Activity is nil, the
// empty-state copy renders. Otherwise the section shows a
// summary line, a 52-week commit heatmap (SVG, painted by
// the JS renderer in a follow-up slice), top contributors,
// per-release activity breakdown, and a stacked bar of
// issues-closed-by-Type. All surfaces are server-rendered;
// the heatmap is the one piece of client-rendered SVG (the
// 52*7=364-cell grid is too dense to inline into the HTML).
templ aboutActivitySection(view viewmodel.AboutView) {
	<section class="card rounded-3xl p-5 sm:p-8 space-y-4" id="about.activity" data-about-activity>
		@components.Heading(components.H2, "Repository activity", "", nil)
		<p class="text-sm text-slate-600">Rolling 52 weeks of git activity baked at release time. The heatmap reads the per-day commit counts; the contributors list is the top 10 by commit count; the issues-closed bar groups closed issues by triage Type label.</p>
		if view.Activity == nil {
			<div class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-[rgb(var(--theme-amber-100-rgb)/0.6)] p-4 text-sm text-amber-950" data-about-activity-empty>
				<p><strong>Repository activity not yet baked for this build.</strong></p>
				<p class="mt-1 text-xs">Run <code class="font-mono">make tpl</code> to bake from <code class="font-mono">git log</code> + the GitHub Issues API. The dev binary ships with no baked data so the empty-state copy reads naturally.</p>
			</div>
		} else {
			@aboutActivitySummary(view.Activity)
			@aboutActivityHeatmap(view.Activity)
			@aboutActivityContributors(view.Activity)
			@aboutActivityPerRelease(view.Activity)
			@aboutActivityIssuesClosed(view.Activity)
		}
	</section>
}

// aboutActivitySummary renders the one-line summary: total
// commits + first/latest dates.
templ aboutActivitySummary(act *viewmodel.ActivitySnapshotView) {
	<p class="text-sm text-slate-700" data-about-activity-summary>
		<strong data-about-activity-commits>{ fmt.Sprintf("%d", act.TotalCommits) }</strong> commits since <span data-about-activity-first>{ act.FirstCommitDate }</span> through <span data-about-activity-latest>{ act.LatestCommitDate }</span> across <strong data-about-activity-contributors-count>{ fmt.Sprintf("%d", act.TotalContributors) }</strong> contributors.
	</p>
}

// aboutActivityHeatmap renders the heatmap host + the JSON
// data attribute the JS renderer reads. The host is empty
// until the JS paints the SVG (the templ's job is the
// data-attribute plumbing; the JS paints the grid).
templ aboutActivityHeatmap(act *viewmodel.ActivitySnapshotView) {
	<div
		class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-3"
		data-about-activity-heatmap
		data-about-activity-heatmap-data={ act.HeatmapData }
	>
		<p class="text-xs text-slate-500" data-about-activity-heatmap-loading>Loading heatmap...</p>
	</div>
}

// aboutActivityContributors renders the top-contributors
// list. The list is server-rendered (no JS needed).
templ aboutActivityContributors(act *viewmodel.ActivitySnapshotView) {
	<div data-about-activity-contributors>
		<h3 class="text-base font-semibold text-[var(--theme-text-primary)]">Top contributors</h3>
		if len(act.TopContributors) == 0 {
			<p class="mt-2 text-sm text-slate-500">No contributors in the rolling window.</p>
		} else {
			<ul class="mt-2 grid gap-2 text-sm sm:grid-cols-2">
				for _, c := range act.TopContributors {
					<li class="rounded-lg border border-[rgb(var(--theme-sepia-rgb)/0.25)] bg-white/30 px-3 py-2" data-about-activity-contributor={ c.Name }>
						<span class="font-mono">{ c.Name }</span>
						<span class="ml-2 text-xs uppercase tracking-[0.18em] text-slate-500">{ fmt.Sprintf("%d commits", c.Count) }</span>
					</li>
				}
			</ul>
		}
	</div>
}

// aboutActivityPerRelease renders the per-release commit
// rollup. Releases whose tag does not exist (CHANGELOG entry
// without a corresponding git tag) render "N/A" for the
// commit count.
templ aboutActivityPerRelease(act *viewmodel.ActivitySnapshotView) {
	<div data-about-activity-per-release>
		<h3 class="text-base font-semibold text-[var(--theme-text-primary)]">Per-release activity</h3>
		if len(act.PerRelease) == 0 {
			<p class="mt-2 text-sm text-slate-500">No release activity baked yet.</p>
		} else {
			<ul class="mt-2 divide-y divide-[rgb(var(--theme-sepia-rgb)/0.25)] text-sm">
				for _, r := range act.PerRelease {
					<li class="flex flex-wrap items-baseline justify-between gap-2 py-2" data-about-activity-per-release-row={ r.Version }>
						<span class="font-mono text-xs text-[var(--theme-text-primary)]">{ r.Version }</span>
						if r.CommitCount == 0 {
							<span class="text-xs text-slate-500" data-about-activity-per-release-count="n/a">N/A (tag missing)</span>
						} else {
							<span class="text-xs text-slate-700" data-about-activity-per-release-count>
								{ fmt.Sprintf("%d", r.CommitCount) } commits &middot; { fmt.Sprintf("%d", r.Contributors) } contributors &middot; +{ fmt.Sprintf("%d", r.LinesAdded) }/-{ fmt.Sprintf("%d", r.LinesRemoved) } LOC
							</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}

// aboutActivityIssuesClosed renders the issues-closed-by-Type
// stacked bar + the legend. The bar itself is a flex row of
// divs (one per Type); each div's width is proportional to
// its share of TotalClosed. The legend lists the same buckets
// with their counts.
templ aboutActivityIssuesClosed(act *viewmodel.ActivitySnapshotView) {
	<div data-about-activity-issues-closed>
		<h3 class="text-base font-semibold text-[var(--theme-text-primary)]">Issues closed by type</h3>
		if act.IssuesClosed.TotalClosed == 0 {
			<p class="mt-2 text-sm text-slate-500">No closed issues baked yet.</p>
		} else {
			<div class="mt-3 flex h-6 w-full overflow-hidden rounded-md border border-[rgb(var(--theme-sepia-rgb)/0.35)]" data-about-activity-issues-bar>
				for _, b := range act.IssuesClosed.ByType {
					<div
						class="h-full"
						style={ fmt.Sprintf("width: %s%%; background-color: %s;", bucketPercent(b.Count, act.IssuesClosed.TotalClosed), bucketColor(b.Type)) }
						data-about-activity-issues-bucket={ b.Type }
						title={ fmt.Sprintf("%s: %d", b.Type, b.Count) }
					></div>
				}
			</div>
			<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
				for _, b := range act.IssuesClosed.ByType {
					<li class="inline-flex items-center gap-1.5" data-about-activity-issues-legend={ b.Type }>
						<span class="inline-block h-2.5 w-2.5 rounded-sm" style={ fmt.Sprintf("background-color: %s;", bucketColor(b.Type)) }></span>
						<span class="text-slate-700">{ b.Type } &middot; { fmt.Sprintf("%d", b.Count) }</span>
					</li>
				}
			</ul>
		}
	</div>
}

// bucketPercent returns the width percent of one bucket
// within the total (rounded to one decimal).
func bucketPercent(count, total int) string {
	if total == 0 {
		return "0"
	}
	return fmt.Sprintf("%.1f", float64(count)/float64(total)*100)
}

// bucketColor maps a triage Type label to a stack-bar slice
// colour. The palette matches the legend chips the rest of
// the about page uses (sepia / gold / green / red / blue).
func bucketColor(typeName string) string {
	switch typeName {
	case "bug":
		return "#a14747" // review red
	case "enhancement":
		return "#7d4f2d" // sepia
	case "documentation":
		return "#4f7d6b" // slate green
	case "duplicate":
		return "#b6854f" // warm gold
	case "question":
		return "#3f5d8a" // ink blue
	case "invalid":
		return "#9c9c9c" // grey
	case "wontfix":
		return "#6b6b6b" // dark grey
	}
	return "#cccccc"
}
// aboutGlossaryRow renders one term as a definition row.
// The kebab anchor (`id="about.glossary-<slug>"`) is what
// every related-term cross-link in this and other rows
// navigates to. The `data-about-glossary-term` hook is
// the click target the future disclosure popover (slice 2)
// opens from. The Short line is the one-line definition
// a glance reads; Full is the paragraph that follows.
templ aboutGlossaryRow(entry viewmodel.GlossaryEntry) {
	<div class="rounded-xl border border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-white/40 p-4" id={ "about.glossary-" + entry.Slug } data-about-glossary-term={ entry.Slug }>
		<dt class="font-mono text-base font-semibold text-[var(--theme-text-primary)]" data-about-glossary-term-name={ entry.Slug }>{ entry.Term }</dt>
		<dd class="mt-2 space-y-2 text-sm text-slate-700">
			<p class="text-[var(--theme-text-primary)]">{ entry.Short }</p>
			<p class="text-slate-600">{ entry.Full }</p>
			if len(entry.Related) > 0 {
				<p class="text-xs text-slate-500">
					<span class="font-semibold uppercase tracking-[0.18em]">See also:</span>
					for i, rel := range entry.Related {
						if i > 0 {
							<span class="px-1">·</span>
						}
						<a href={ templ.SafeURL("#about.glossary-" + rel) } class="underline">[{ rel }]</a>
					}
				</p>
			}
		</dd>
	</div>
}
