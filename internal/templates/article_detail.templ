// article_detail.templ — v62 (issue #321 slice 1 + slice 3)
// Article detail page. Slice 1 renders the title + subtitle
// + body verbatim from the viewmodel. Slice 3.2 adds the Refs
// panel (Person Records this article cites, with Unlink
// buttons + an "Add Ref" CTA that opens the picker modal
// landed in slice 3.3). Slice 3.4 adds the Revisions tab +
// the Save copy / Restore / Delete affordances. Slice 3.6
// swaps the verbatim Body for the sanitized HTML render.
// Slice 3.7 (issue #431) adds the /articles/{id}/edit CTA
// next to the DisplayID so a user editing an existing article
// doesn't need to know the route shape.
//
// The picker modal lives in components/person_record_picker.templ;
// the Revisions tab fragment lives in
// components/article_revisions.templ.
package templates

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ ArticleDetailShell(view viewmodel.Article) {
	@Layout(view.Title) {
		<div class="relative mx-auto max-w-4xl">
			<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
				<a
					href={ templ.SafeURL(routebuilder.ArticleList()) }
					class="secondary-button"
				>← Back to Articles</a>
				<div class="flex flex-wrap items-center gap-3">
					<span class="font-mono text-xs text-slate-500" data-article-display-id>{ view.DisplayID }</span>
					<a
						href={ templ.SafeURL(routebuilder.ArticleEdit(view.ID)) }
						class="pill-link"
						data-article-edit-link
					>Edit</a>
				</div>
			</div>
			<div class="mb-4 flex flex-wrap items-center justify-end gap-3 rounded-2xl border border-slate-200 bg-white/60 px-4 py-3" data-article-export-bar>
				@components.ArticlePDFExport(view.ID)
				@components.ArticleRawDownload(view.ID)
			</div>
			<article class="card rounded-3xl p-5 sm:p-8 space-y-4">
				@components.Heading(components.H1, view.Title, "", nil)
				if view.Subtitle != "" {
					<p class="text-lg text-slate-600" data-article-subtitle>{ view.Subtitle }</p>
				}
				<div class="prose prose-sm max-w-none text-sm leading-relaxed text-[color:var(--ink)]" data-article-body>@templ.Raw(view.Body)</div>
				if len(view.ResolvedRefs) > 0 {
					<div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-600" data-article-resolved-refs>
						<p class="mb-2 font-semibold uppercase tracking-[0.18em] text-slate-500">Cited Person Records</p>
						<ul class="flex flex-wrap gap-2">
							for _, ref := range view.ResolvedRefs {
								if ref.Resolved {
									<li>
										<a
											href={ templ.SafeURL(routebuilder.SoldierDetail(ref.PersonRecordID)) }
											class="pill-link"
											data-article-resolved-ref
											data-article-resolved-ref-token={ ref.Token }
										>{ ref.PersonDisplayID }</a>
									</li>
								} else {
									<li>
										<span
											class="pill-link border-amber-700/40 bg-amber-50 text-amber-900"
											data-article-resolved-ref
											data-article-resolved-ref-unknown="true"
											title="Display ID not found in the archive. Resolve the token or remove it from the body."
										>⚠ Unknown: { ref.Token }</span>
									</li>
								}
							}
						</ul>
					</div>
				}
			</article>
			@ArticleRefsPanel(view)
			@ArticleRevisionsTab(view)
		</div>
	}
}

// ArticleRefsPanel renders the inline Refs panel on the
// /articles/{id} detail page. One row per attached Person
// Record, each with an Unlink button (data-action + DELETE
// to the existing ArticleRefsDetach route per the
// post-Option-C convention). The "Add Ref" CTA is the
// picker trigger (slice 3.3); clicking it opens the inline
// picker.
templ ArticleRefsPanel(view viewmodel.Article) {
	<section class="card mt-6 rounded-3xl p-5 sm:p-8 space-y-4" data-article-refs-panel>
		<div class="flex flex-wrap items-center justify-between gap-3">
			@components.Heading(components.H2, "Person Records", "", nil)
			@components.PersonRecordPickerTrigger(view.ID)
		</div>
		<div data-person-record-picker-target></div>
		if len(view.Refs) == 0 {
			<p class="text-sm text-slate-600" data-article-refs-empty>No Person Records attached. Click "Add Person Record" above to attach one.</p>
		} else {
			<ul class="space-y-2" data-article-refs-list>
				for _, ref := range view.Refs {
					<li class="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm" data-article-refs-row data-article-refs-person-id={ fmt.Sprintf("%d", ref.PersonRecordID) }>
						<div class="flex flex-wrap items-baseline gap-3">
							<a
								href={ templ.SafeURL(routebuilder.SoldierDetail(ref.PersonRecordID)) }
								class="font-mono text-sm font-semibold text-[color:var(--ink)]"
								data-article-refs-row-display-id
							>{ ref.PersonDisplayID }</a>
							<span class="font-mono text-xs text-slate-400">{ ref.PersonSyncID }</span>
						</div>
						@components.Button("Unlink", components.ButtonSecondary, "", templ.Attributes{
							"data-action":                    templ.SafeURL(routebuilder.ArticleRefsDetach(view.ID, ref.PersonRecordID)),
							"data-method":                    "DELETE",
							"data-dixie-submit":              "true",
							"data-confirm":                   "Unlink this Person Record from the article?",
							"data-article-refs-unlink":       "",
							"data-article-refs-person-id":    fmt.Sprintf("%d", ref.PersonRecordID),
							"data-article-refs-article-id":   fmt.Sprintf("%d", view.ID),
						})
					</li>
				}
			</ul>
		}
	</section>
}

// ArticleRevisionsTab renders the Revisions tab UI + the
// initial snapshot list. Uses the data-tab-group pattern
// (see components/soldier_card.templ:81-92) so
// initializeTabs() in app.js auto-wires the tab switches.
//
// Slice 3.4 ships this with no edit-snapshot affordance
// (per the breq/185 follow-up); the snapshot row exposes
// only Restore + Delete.
templ ArticleRevisionsTab(view viewmodel.Article) {
	<section class="card mt-6 rounded-3xl p-5 sm:p-8 space-y-4" data-article-revisions-tab>
		<div class="flex flex-wrap items-center justify-between gap-3">
			@components.Heading(components.H2, "Revisions", "", nil)
			<span class="font-mono text-xs text-slate-500" data-article-revisions-count>{ fmt.Sprintf("%d saved", len(view.Snapshots)) }</span>
		</div>
		@components.ArticleRevisionsList(view.ID, view.Snapshots)
	</section>
}