// articles.templ — v62 (issue #321) Articles list page.
//
// slice 1 shipped an empty-state placeholder because the
// /articles list surface had no ArticleService.List method.
// slice 2 fills in the per-row card grid: each Article
// renders as a card with title + subtitle + a pill to the
// detail page. The empty state stays so a fresh archive
// renders the existing CTA.
package templates

import (
	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ ArticlesListShell(articles []viewmodel.Article) {
	@Layout("Articles") {
		<div class="relative mx-auto max-w-4xl">
			<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
				<h1 class="font-display text-3xl font-semibold text-[color:var(--ink)]">Articles</h1>
				<a
					href={ templ.SafeURL(routebuilder.ArticleNew()) }
					class="primary-button"
				>Create Article</a>
			</div>
			if len(articles) == 0 {
				@components.EmptyState(
					"No articles yet",
					"Articles are long-form essays with inline Person Record references. The list is empty because no articles have been authored in this archive yet — click Create Article above to start one.",
					routebuilder.ArticleNew(),
				)
			} else {
				<div class="space-y-3" data-articles-list>
					for _, article := range articles {
						<a
							href={ templ.SafeURL(routebuilder.ArticleByID(article.ID)) }
							class="card block rounded-2xl p-4 transition hover:border-research-border hover:bg-research-bg"
							data-article-row
							data-article-id={ templ.SafeURL(routebuilder.ArticleByID(article.ID)) }
						>
							<div class="flex flex-wrap items-baseline justify-between gap-2">
								<h2 class="text-lg font-semibold text-[color:var(--ink)]" data-article-row-title>{ article.Title }</h2>
								<span class="font-mono text-xs text-slate-500" data-article-row-display-id>{ article.DisplayID }</span>
							</div>
							if article.Subtitle != "" {
								<p class="mt-1 text-sm text-slate-600" data-article-row-subtitle>{ article.Subtitle }</p>
							}
							if article.BodyExcerpt != "" {
								<p
									class="mt-2 text-sm leading-relaxed text-slate-700 line-clamp-3"
									data-article-preview
								>{ article.BodyExcerpt }</p>
							}
						</a>
					}
				</div>
			}
		</div>
	}
}
