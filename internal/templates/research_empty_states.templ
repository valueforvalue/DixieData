// research_empty_states.templ — Empty-state pages for Research
// sub-pages when soldier data is missing (issue #422 slice 1).
// These pages render a 200 with a helpful message instead of
// the 500 "Could not build..." that the service layer returns.
package templates

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
)

// UnitCamaraderieEmpty renders when the soldier has no unit,
// regiment, or company information recorded.
templ UnitCamaraderieEmpty(name string, id int64) {
	@Layout("Unit Camaraderie") {
		<div class="mx-auto max-w-4xl space-y-6 pt-8">
			<header class="space-y-2">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Unit Camaraderie</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--ink)]">{ name }</h1>
			</header>
			<div class="card rounded-3xl p-8 space-y-4">
				<p class="text-lg font-semibold text-[color:var(--ink)]">No unit information yet</p>
				<p class="text-sm text-slate-600">
					This Person Record does not have a unit, regiment, or company recorded.
					The Unit Camaraderie page shows soldiers who served in the same
					unit — it needs at least a unit name to build the graph.
				</p>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/edit", id)) }
					class="pill-link"
				>
					Edit this record to add unit information
				</a>
				<a
					href={ templ.SafeURL(routebuilder.ResearchClear()) }
					class="pill-link"
				>
					Pick a different Person Record
				</a>
			</div>
		</div>
	}
}

// ResearchPackCountyEmpty renders when the soldier has no
// birth_info field (or the field doesn't contain a county).
templ ResearchPackCountyEmpty(name string, id int64) {
	@Layout("Research Pack") {
		<div class="mx-auto max-w-4xl space-y-6 pt-8">
			<header class="space-y-2">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Research Pack — County</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--ink)]">{ name }</h1>
			</header>
			<div class="card rounded-3xl p-8 space-y-4">
				<p class="text-lg font-semibold text-[color:var(--ink)]">No county information yet</p>
				<p class="text-sm text-slate-600">
					This Person Record does not have a county recorded in its birth
					information. The County Research Pack groups records by the county
					the soldier was born in — it needs at least a county in the form
					"County Name, State" to build the pack.
				</p>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/soldiers/%d/edit", id)) }
					class="pill-link"
				>
					Edit this record to add birth information
				</a>
				<a
					href={ templ.SafeURL(routebuilder.ResearchClear()) }
					class="pill-link"
				>
					Pick a different Person Record
				</a>
			</div>
		</div>
	}
}
