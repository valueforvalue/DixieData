// research_picker.templ - Research & Review Person picker landing
// (issue #378 slice 1 + slice 2 + slice 3). The picker is the entry
// point for the top-nav Research & Review foldout and the landing
// route for soldier-scoped sub-pages when no dd_person_ctx cookie
// is set.
//
// Slice 1: page shell (search input, Continue shortcut, empty
//   Results + Recent placeholders).
// Slice 2: live htmx search swap; picker forms forward ?next=
//   through to /research/select so the post-redirect lands on the
//   correct sub-page; results-only fragment kept as a separate
//   component so the picker handler can return just the panel
//   when ?partial=1 is set.
// Slice 3: Recent list populated by app.js reading localStorage on
//   page load + new /research/recent fragment endpoint.
package templates

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/uiids"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

// pickerActionLabel returns a human-readable label for a picker
// action key (issue #422 slice 2). Used by the Continue shortcut
// to render button text. The keys stay kebab-case for form values
// (so the pickerNextAction allowlist in the handler still matches)
// while the labels are Title Case for display.
func pickerActionLabel(action string) string {
	switch action {
	case "camaraderie":
		return "Camaraderie"
	case "timeline":
		return "Timeline"
	case "research-log":
		return "Research Log"
	case "conflict-ledger":
		return "Conflict Ledger"
	case "research-pack":
		return "Research Pack"
	}
	return action
}

// pickerNextEcho returns the value to render into the hidden ?next
// field of every picker form. Falls back to "camaraderie" when the
// supplied view has no NextAction (avoids echo'ing an empty string,
// which would 400 at select-time).
func pickerNextEcho(view viewmodel.ResearchPickerView) string {
	if view.NextAction != "" {
		return view.NextAction
	}
	return "camaraderie"
}

templ ResearchPickerView(view viewmodel.ResearchPickerView) {
	@Layout("Research & Review") {
		<div id={ uiids.PageResearchPicker } class="relative mx-auto max-w-4xl space-y-6">
			<header class="space-y-2">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Research & Review</p>
				<h1 class="font-display text-3xl font-semibold text-[color:var(--ink)]">Choose a Person Record</h1>
				<p class="text-sm text-slate-600">
					Pick the Person Record you want to research. Your selection is stored in a signed cookie so navigating between sub-pages does not re-prompt.
				</p>
			</header>
			if view.CurrentPerson != nil {
				<div id={ uiids.PanelResearchPickerContinue } class="card rounded-3xl p-5 space-y-3">
					<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Continue</p>
					<p class="text-base text-[color:var(--ink)]">
						Continue: { view.CurrentPerson.FirstName } { view.CurrentPerson.LastName }
						<span class="font-mono text-xs text-slate-500">({ view.CurrentPerson.DisplayID })</span>
					</p>
					// Issue #422 slice 2: one Continue button per
					// supported sub-page. Soldiers missing the data
					// for a sub-page don't see that button (e.g. no
					// unit => no Camaraderie). The Change Person
					// form stays separate (no person_id needed).
					<div class="flex flex-wrap items-center gap-2">
						for _, action := range view.SupportedActions {
							<form
								method="post"
								action={ templ.SafeURL(routebuilder.ResearchSelect()) }
								class="inline"
								data-dixie-submit="true"
							>
								<input type="hidden" name="person_id" value={ fmt.Sprintf("%d", view.CurrentPerson.ID) }/>
								<input type="hidden" name="next" value={ action }/>
								<button type="submit" class="pill-link" data-research-continue-action={ action }>Continue to { pickerActionLabel(action) }</button>
							</form>
						}
						<form
							method="post"
						action={ templ.SafeURL(routebuilder.ResearchClear()) }
						class="inline"
						data-dixie-submit="true"
					>
							<button type="submit" class="pill-link" data-research-clear>Change Person…</button>
						</form>
					</div>
				</div>
			}
			<section id={ uiids.PanelResearchPickerSearch } class="card rounded-3xl p-5 space-y-3">
				<label class="block text-sm font-medium text-[color:var(--ink)]" for="research-picker-query">Search by name or Display ID</label>
				<form
					method="get"
					action={ templ.SafeURL(routebuilder.ResearchPicker()) }
					class="flex flex-wrap items-center gap-2"
				>
					<input
						id="research-picker-query"
						type="search"
						name="q"
						value={ view.SearchQuery }
						placeholder="e.g. Gillespie or CSA-00411"
						class="flex-1 min-w-[12rem] rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.6)] px-4 py-2 text-sm text-[color:var(--ink)]"
						data-research-query
						hx-get={ templ.SafeURL(routebuilder.ResearchSearch()) }
						hx-trigger="keyup changed delay:300ms, search"
						hx-target={ "#" + uiids.PanelResearchPickerResults }
						hx-swap="outerHTML"
						hx-include="[name='next']"
					/>
					if view.NextAction != "" {
						<input type="hidden" name="next" value={ view.NextAction }/>
					}
					<button type="submit" class="pill-link">Search</button>
				</form>
				<div id={ uiids.PanelResearchPickerResults } class="space-y-2" data-research-results>
					@ResearchPickerSearchResults(view)
				</div>
			</section>
			if view.NextAction == "research-pack" {
				<section id={ uiids.PanelResearchPickerPackSubScreen } class="card rounded-3xl p-5 space-y-3" data-research-pack-sub-screen>
					<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Research Pack geography</p>
					<p class="text-sm text-slate-600">Choose state or county before picking the Person Record. The choice is forwarded into the sub-page URL.</p>
					<form
						method="get"
						action={ templ.SafeURL(routebuilder.ResearchPicker()) }
						class="flex flex-wrap items-center gap-2"
					>
						<input type="hidden" name="next" value="research-pack"/>
						<label class="text-sm text-[color:var(--ink)]" for="research-pack-geography">Geography</label>
						<select
							id="research-pack-geography"
							name="geography"
							class="rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.6)] px-4 py-2 text-sm text-[color:var(--ink)]"
							data-research-pack-geography
						>
							<option value="state" data-research-pack-state>State</option>
							if view.HasCountyInBirth {
								<option value="county" data-research-pack-county>County</option>
							}
						</select>
						<button type="submit" class="pill-link">Save choice</button>
					</form>
				</section>
			}
			<section id={ uiids.PanelResearchPickerRecent } class="card rounded-3xl p-5 space-y-3">
				<p class="text-xs uppercase tracking-[0.2em] text-slate-500">Recent</p>
				@ResearchPickerRecent(view)
			</section>
		</div>
	}
}

// ResearchPickerSearchResults is the results-only fragment returned
// by handleResearchPicker when ?partial=1 is set (issue #378 slice 2
// option B2). The htmx live-search swap on the search input replaces
// this wrapper, not the whole picker page.
templ ResearchPickerSearchResults(view viewmodel.ResearchPickerView) {
	<div id={ uiids.PanelResearchPickerResults } class="space-y-2" data-research-results>
		if len(view.SearchResults) == 0 && view.SearchQuery == "" {
			<p class="text-sm text-slate-500">Type a name or Display ID to find a Person Record.</p>
		} else if len(view.SearchResults) == 0 {
			<p class="text-sm text-slate-500">No matches for that query.</p>
		} else {
			for _, person := range view.SearchResults {
				<form
					method="post"
					action={ templ.SafeURL(routebuilder.ResearchSelect()) }
					class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.4)] px-4 py-3"
					data-dixie-submit="true"
				>
					<div>
						<p class="text-base font-medium text-[color:var(--ink)]">{ person.FirstName } { person.LastName }</p>
						<p class="font-mono text-xs text-slate-500">{ person.DisplayID }</p>
					</div>
					<input type="hidden" name="person_id" value={ fmt.Sprintf("%d", person.ID) }/>
					<input type="hidden" name="next" value={ pickerNextEcho(view) }/>
					<button type="submit" class="pill-link">Open</button>
				</form>
			}
		}
	</div>
}

// ResearchPickerRecent renders just the recents-list ul region
// (issue #378 slice 3, option C1). The full picker page embeds
// this directly; the standalone /research/recent fragment endpoint
// renders it for the JS-driven swap on localStorage hydration.
templ ResearchPickerRecent(view viewmodel.ResearchPickerView) {
	if len(view.RecentPersons) == 0 {
		<p class="text-sm text-slate-500" data-research-recent-empty>No recent picks yet. Open a Person Record from a search result and it will appear here.</p>
	} else {
		<ul class="space-y-2" data-research-recent-list>
			for _, person := range view.RecentPersons {
				<li>
					<form
						method="post"
						action={ templ.SafeURL(routebuilder.ResearchSelect()) }
						class="flex flex-wrap items-center justify-between gap-3"
					>
						<div>
							<p class="text-base font-medium text-[color:var(--ink)]">{ person.FirstName } { person.LastName }</p>
							<p class="font-mono text-xs text-slate-500">{ person.DisplayID }</p>
						</div>
						<input type="hidden" name="person_id" value={ fmt.Sprintf("%d", person.ID) }/>
						<input type="hidden" name="next" value={ pickerNextEcho(view) }/>
						<button type="submit" class="pill-link">Open</button>
					</form>
				</li>
			}
		</ul>
	}
}
