package templates

import (
	"fmt"
	"strings"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/templates/components"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ CalendarDayDetailPage(day viewmodel.CalendarDayDetail) {
	@Layout("Anniversary — " + calendarDayHeading(day.Month, day.Day)) {
		@CalendarDayDetail(day)
	}
}

templ CalendarDayDetail(day viewmodel.CalendarDayDetail) {
	<div class="space-y-6">
		<div>
			<h3 class="gold text-4xl leading-none">{ calendarDayHeading(day.Month, day.Day) }</h3>
			<p class="mt-2 text-sm leading-relaxed text-[var(--theme-text-mid)]">Review anniversaries first, then manage recurring events and holidays for this date.</p>
		</div>
		if strings.TrimSpace(day.StatusMessage) != "" {
			<div class={ calendarDayStatusClass(day.StatusKind) }>{ day.StatusMessage }</div>
		}
		if day.AllowCustomItems {
			@CalendarDayActions(day)
		}
		@CalendarDayAnniversaries(day)
		if day.AllowCustomItems {
			@CalendarDayCustomItems(day)
		}
	</div>
}

templ CalendarDayActions(day viewmodel.CalendarDayDetail) {
	<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-[rgb(var(--theme-white-rgb)/0.72)] px-4 py-4">
		<div>
			<p class="text-xs font-semibold uppercase tracking-[0.22em] text-[var(--theme-accent-strong)]">Calendar Actions</p>
			<p class="mt-1 text-sm text-[var(--theme-text-muted)]">Add or edit yearly events and holidays without crowding the day view.</p>
		</div>
		if day.Form.EditingID > 0 || strings.TrimSpace(day.Form.ErrorMessage) != "" {
			<details class="relative" open>
				<summary class="secondary-button list-none cursor-pointer gap-2">
					<span>{ calendarDayFormSummary(day.Form) }</span>
					<span class="text-[0.68rem] uppercase tracking-[0.16em] text-[var(--theme-accent-strong)]">Event / Holiday</span>
				</summary>
				@CalendarDayActionMenu(day)
			</details>
		} else {
			<details class="relative">
				<summary class="secondary-button list-none cursor-pointer gap-2">
					<span>{ calendarDayFormSummary(day.Form) }</span>
					<span class="text-[0.68rem] uppercase tracking-[0.16em] text-[var(--theme-accent-strong)]">Event / Holiday</span>
				</summary>
				@CalendarDayActionMenu(day)
			</details>
		}
	</div>
}

templ CalendarDayAnniversaries(day viewmodel.CalendarDayDetail) {
	<div class="space-y-3">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<h4 class="text-lg font-semibold text-[var(--theme-text-primary)]">Anniversaries</h4>
				<p class="mt-1 text-sm text-[var(--theme-text-muted)]">Expanded is the default. Switch to compact rows when you want a tighter scan.</p>
			</div>
			<div class="inline-flex items-center gap-2 rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-white/70 px-2 py-2">
				<button type="button" data-calendar-anniversary-density-toggle="expanded" class="rounded-full border border-[var(--theme-text-primary)] bg-[rgb(var(--theme-ink-deep-rgb)/0.92)] px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--theme-accent-glow)] transition">Expanded</button>
				<button type="button" data-calendar-anniversary-density-toggle="compact" class="rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-[var(--theme-text-muted)] transition">Compact</button>
			</div>
		</div>
		if len(day.Anniversaries) == 0 {
			<p class="rounded-2xl border border-dashed border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-[rgb(var(--theme-white-rgb)/0.62)] px-4 py-4 text-sm text-[var(--theme-text-muted)]">No person records for this date.</p>
		} else {
			<div data-calendar-anniversary-density="expanded" class="space-y-3">
				for _, soldier := range day.Anniversaries {
					<div data-calendar-anniversary-expanded>
						@SoldierCard(soldier, false)
					</div>
					@CalendarAnniversaryCompactRow(soldier)
				}
			</div>
		}
	</div>
}

templ CalendarDayCustomItems(day viewmodel.CalendarDayDetail) {
	<div class="space-y-3">
		<div>
			<h4 class="text-lg font-semibold text-[var(--theme-text-primary)]">Events &amp; Holidays</h4>
			<p class="mt-1 text-sm text-[var(--theme-text-muted)]">Recurring custom items appear every year on this date.</p>
		</div>
		if len(day.Items) == 0 {
			<p class="rounded-2xl border border-dashed border-[rgb(var(--theme-sepia-rgb)/0.35)] bg-[rgb(var(--theme-white-rgb)/0.62)] px-4 py-4 text-sm text-[var(--theme-text-muted)]">No custom calendar items yet for this date.</p>
		} else {
			<div class="space-y-2">
				for _, item := range day.Items {
					<div class="rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-[rgb(var(--theme-white-rgb)/0.78)] px-4 py-3">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center gap-2">
									<span class={ calendarItemDotClass(item.ItemType) }></span>
									<span class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-muted)]">{ calendarItemTypeLabel(item.ItemType) }</span>
									<h5 class="text-base font-semibold text-[var(--theme-text-primary)]">{ item.Title }</h5>
								</div>
								if strings.TrimSpace(item.Notes) != "" {
									<p class="mt-2 text-sm leading-6 text-[var(--theme-text-mid)]">{ item.Notes }</p>
								}
							</div>
							<div class="flex flex-wrap gap-2">
								<button
									hx-get={ templ.SafeURL(routebuilder.AnniversaryEdit(day.Month, day.Day, item.ID)) }
									hx-target="#details-pane"
									hx-swap="innerHTML"
									class="ghost-link px-3 py-2"
								>
									Edit
								</button>
								<button
									data-action={ templ.SafeURL(routebuilder.AnniversaryItemDelete(day.Month, day.Day, item.ID)) }
									data-confirm={ fmt.Sprintf("Delete '%s'? It will stop appearing on %s each year and any research-note link will be removed.", item.Title, calendarDayHeading(day.Month, day.Day)) }
									data-dixie-submit="true"
									class="danger-button px-3 py-2"
								>
									Delete
								</button>
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ CalendarAnniversaryCompactRow(soldier viewmodel.PersonRecord) {
	<div data-calendar-anniversary-compact class="hidden rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.24)] bg-[rgb(var(--theme-white-rgb)/0.8)] px-4 py-3">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="min-w-0 flex-1">
				<a href={ fmt.Sprintf("/soldiers/%d", soldier.ID) } class="font-semibold text-[var(--theme-text-primary)] hover:text-[var(--theme-review-red)]">{ detailHeading(soldier) }</a>
				<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
					if strings.TrimSpace(soldier.DisplayID) != "" {
						<span class="font-mono text-[var(--theme-review-red)]">{ soldier.DisplayID }</span>
					}
					if strings.TrimSpace(detailSubheading(soldier)) != "" {
						<span>{ detailSubheading(soldier) }</span>
					}
				</div>
			</div>
			<div class="flex items-center gap-2">
				<button type="button" data-share-queue-add={ fmt.Sprintf("%d", soldier.ID) } class="rounded-full border border-[rgb(var(--theme-sepia-rgb)/0.45)] bg-white/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--theme-accent-strong)] hover:bg-white" title={ "Add " + soldier.DisplayID + " to the Share Queue" }>
					+ Queue
				</button>
				<a href={ fmt.Sprintf("/soldiers/%d", soldier.ID) } class="ghost-link px-3 py-2">Open Record</a>
			</div>
		</div>
	</div>
}

templ CalendarDayActionMenu(day viewmodel.CalendarDayDetail) {
	<div data-popout-panel class="absolute right-0 z-20 mt-3 w-[min(28rem,calc(100vw-5rem))] rounded-2xl border border-[rgb(var(--theme-sepia-rgb)/0.28)] bg-[rgba(255,248,230,0.98)] p-4 shadow-[0_18px_32px_rgba(23,33,43,0.14)]">
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h4 class="text-lg font-semibold text-[var(--theme-text-primary)]">{ calendarDayFormSummary(day.Form) }</h4>
				<p class="mt-1 text-sm text-[var(--theme-text-muted)]">Titles are required. Notes are optional. Duplicate titles are allowed.</p>
			</div>
			if day.Form.EditingID > 0 {
				<button
					hx-get={ templ.SafeURL(routebuilder.Anniversary(day.Month, day.Day)) }
					hx-target="#details-pane"
					hx-swap="innerHTML"
					class="ghost-link px-3 py-2"
				>
					Cancel Edit
				</button>
			}
		</div>
		if strings.TrimSpace(day.Form.ErrorMessage) != "" {
			<p class="mt-4 rounded-xl border border-[rgb(var(--theme-review-red-rgb)/0.28)] bg-[rgb(var(--theme-review-red-rgb)/0.08)] px-4 py-3 text-sm text-[var(--theme-review-red)]">{ day.Form.ErrorMessage }</p>
		}
		if day.Form.EditingID > 0 {
			<form
				class="mt-4 grid gap-4"
				action={ templ.SafeURL(routebuilder.AnniversaryItemUpdate(day.Month, day.Day, day.Form.EditingID)) }
				data-dixie-submit="true"
			>
				@CalendarItemFormFields(day.Form)
				<div class="flex flex-wrap items-center justify-between gap-3">
					<span class="text-xs uppercase tracking-[0.18em] text-[var(--theme-text-muted)]">Editing in place</span>
					@components.Button("Save Changes", components.ButtonPrimary, "px-5 py-2", nil)
				</div>
			</form>
		} else {
			<form
				class="mt-4 grid gap-4"
				action={ templ.SafeURL(routebuilder.AnniversaryItemCreate(day.Month, day.Day)) }
				data-dixie-submit="true"
			>
				@CalendarItemFormFields(day.Form)
				<div class="flex flex-wrap items-center justify-between gap-3">
					<span class="text-xs uppercase tracking-[0.18em] text-[var(--theme-text-muted)]">Appears on this date every year</span>
					@components.Button("Add Item", components.ButtonPrimary, "px-5 py-2", nil)
				</div>
			</form>
		}
	</div>
}

templ CalendarItemFormFields(form viewmodel.CalendarItemForm) {
	<div class="grid gap-4 md:grid-cols-[180px_minmax(0,1fr)]">
		<label class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-muted)]" for="calendar-item-type">Type</label>
		<select id="calendar-item-type" name="item_type" class="field-input max-w-xs">
			<option value="event" if form.ItemType == "event" { selected }>Event</option>
			<option value="holiday" if form.ItemType == "holiday" { selected }>Holiday</option>
		</select>
		<label class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-muted)]" for="calendar-item-title">Title</label>
		<input id="calendar-item-title" name="title" value={ form.Title } class="field-input" maxlength="120" placeholder="Memorial service"/>
		<label class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--theme-text-muted)]" for="calendar-item-notes">Notes</label>
		<textarea id="calendar-item-notes" name="notes" rows="3" class="field-input resize-y" placeholder="Optional context or reminder">{ form.Notes }</textarea>
	</div>
}

func calendarDayHeading(month, day int) string {
	if day <= 0 {
		return monthName(month) + " (unknown day)"
	}
	return fmt.Sprintf("%s %d", monthName(month), day)
}

func calendarItemTypeLabel(itemType string) string {
	switch itemType {
	case "holiday":
		return "Holiday"
	default:
		return "Event"
	}
}

func calendarItemDotClass(itemType string) string {
	switch itemType {
	case "holiday":
		return "inline-flex h-3 w-3 rounded-full border border-[#7d2a2a] bg-[#d98989]"
	default:
		return "inline-flex h-3 w-3 rounded-full border border-[#265c8a] bg-[#7cb3e2]"
	}
}

func calendarDayFormSummary(form viewmodel.CalendarItemForm) string {
	if form.EditingID > 0 {
		return "Edit Calendar Item"
	}
	return "Add Event or Holiday"
}

func calendarDayStatusClass(kind string) string {
	base := "rounded-2xl border px-4 py-3 text-sm"
	if kind == "success" {
		return base + " border-[rgba(38,101,66,0.28)] bg-[rgba(38,101,66,0.09)] text-[#1f5b3b]"
	}
	return base + " border-[rgb(var(--theme-review-red-rgb)/0.28)] bg-[rgb(var(--theme-review-red-rgb)/0.08)] text-[var(--theme-review-red)]"
}
