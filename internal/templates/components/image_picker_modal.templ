// image_picker_modal.templ — issue #612 slice 3
// Article editor image picker modal. The user clicks the
// toolbar's Image button; the modal opens with two tabs
// (Upload + Pick existing) + a manual URL fallback. Picked
// or uploaded images are inserted at the cursor in
// <textarea id="article-body"> via the shared
// window.__dixieInsertTextAtCursor helper (issue #610
// slice 2).
//
// The Upload tab uses htmx POST with multipart/form-data
// encoding so the Wails dispatcher (dispatchDixieDataForm
// in frontend/app.js) applies the multipart-to-urlencoded
// workaround on wails.localhost — the file input is stripped
// but the server falls through to the native
// OpenMultipleFilesDialog path (same pattern as the existing
// soldier image import, handleImportSoldierImages).
// In web mode, the multipart body survives and the server
// reads the files directly.
//
// The Pick existing tab uses htmx GET with a custom event
// trigger (load-image-picker-existing) so it only loads when
// the user switches to that tab, not on page load.
//
// The modal matches the overlay vocabulary: fixed inset-0,
// role="dialog", aria-modal="true", showOverlayModal /
// hideOverlayModal helpers.
package components

import (
	"fmt"
)

// ImagePickerModal renders the image picker modal for the
// article editor. Pass articleID=0 for the new-article form
// (tabs disabled, manual URL only); pass the real article
// row id for the edit form (full upload + pick flow).
templ ImagePickerModal(articleID int64) {
	<div
		id="image-picker-modal"
		role="dialog"
		aria-modal="true"
		aria-labelledby="image-picker-modal-heading"
		data-image-picker-modal
		class="fixed inset-0 z-[96] hidden items-start justify-center overflow-y-auto bg-[rgba(15,23,42,0.58)] px-4 py-4 sm:items-center sm:py-8"
	>
		<div class="relative w-full max-w-lg max-h-[calc(100vh-2rem)] overflow-y-auto rounded-[2rem] border border-[rgba(141,116,64,0.8)] bg-[rgb(var(--theme-parchment-rgb)/0.98)] p-6 shadow-[0_24px_60px_rgba(15,23,42,0.35)] sm:max-h-[calc(100vh-4rem)] sm:p-7">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<h2 id="image-picker-modal-heading" class="text-xl font-semibold text-[color:var(--ink)]">Insert image</h2>
				<button
					type="button"
					class="secondary-button w-full px-4 sm:w-auto"
					data-image-picker-close
				>Close</button>
			</div>
			<div class="mt-6" data-image-picker-body>
				if articleID > 0 {
					// Tab bar — Upload + Pick existing
					<div class="flex gap-2 border-b border-slate-200 pb-2" role="tablist" aria-label="Image source">
						<button
							type="button"
							role="tab"
							aria-selected="true"
							class="rounded-lg px-4 py-2 text-sm font-semibold text-[color:var(--ink)] bg-slate-100"
							data-image-picker-tab="upload"
						>Upload</button>
						<button
							type="button"
							role="tab"
							aria-selected="false"
							class="rounded-lg px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50"
							data-image-picker-tab="existing"
						>Pick existing</button>
					</div>
					// Upload tab panel — plain form with no
					// file input. The server's Wails branch
					// opens a native OpenMultipleFilesDialog;
					// the web-mode branch falls through to an
					// error (web users paste/drop instead).
					<div class="mt-4" data-image-picker-panel="upload">
						<form
							action={ templ.URL("/articles/" + fmt.Sprint(articleID) + "/images/import") }
							method="post"
							data-dixie-submit="true"
							data-results-target={ fmt.Sprintf("[data-image-picker-existing-list][data-article-id='%d']", articleID) }
						>
							<p class="text-sm text-slate-600 mb-3">Import images from your device into this article's local archive.</p>
							<button
								type="submit"
								class="primary-button"
							>Import from device</button>
						</form>
					</div>
					// Pick existing tab panel — htmx GET
					// triggered by a custom event so it only
					// loads on first tab activation, not on
					// page load. The init JS fires the event
					// when the user clicks the tab.
					<div class="mt-4 hidden" data-image-picker-panel="existing">
						<div
							data-image-picker-existing-list
							data-article-id={ fmt.Sprint(articleID) }
							hx-get={ templ.URL("/articles/" + fmt.Sprint(articleID) + "/images") }
							hx-trigger="load-image-picker-existing from:body"
							hx-swap="innerHTML"
						>
							<p class="text-sm text-slate-500">Loading…</p>
						</div>
					</div>
				} else {
					// New-article form: neither tab works without
					// an article row.
					<div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800" data-image-picker-no-article>
						Save the article first to upload or pick images from the local archive. In the meantime, paste an external image URL below.
					</div>
				}
				// Manual URL input — always available.
				<div class="mt-4 space-y-3">
					<div>
						<label for="image-picker-url" class="block text-sm font-semibold text-[color:var(--ink)]">Image URL</label>
						<input
							type="url"
							id="image-picker-url"
							placeholder="https://example.com/image.jpg"
							class="field-input mt-1 w-full text-sm"
							data-image-picker-url
						/>
						<p class="mt-1 text-xs text-slate-500">Paste an external image URL or a /media/… path from the local archive.</p>
					</div>
					<div>
						<label for="image-picker-alt" class="block text-sm font-semibold text-[color:var(--ink)]">Alt text</label>
						<input
							type="text"
							id="image-picker-alt"
							placeholder="Describe the image"
							class="field-input mt-1 w-full text-sm"
							data-image-picker-alt
						/>
					</div>
					<div class="flex justify-end">
						<button
							type="button"
							class="primary-button"
							data-image-picker-insert-url
						>Insert</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}