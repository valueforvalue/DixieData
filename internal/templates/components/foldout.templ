package components

// Foldout is the generic top-nav foldout primitive used by the
// Share nav (issue #264) and any future nav item that needs to
// surface multiple destinations under one trigger. The pattern
// is "first consumer" — Share proved the pattern out, future
// consumers (Browse, Review Queue) can copy the Foldout and
// just swap the items.
//
// ARIA contract (issue #264, locked decision "only the trigger
// gets aria-current=page, never sub-items"):
//   - The trigger is a <button> with aria-haspopup="menu",
//     aria-expanded (mirrored by JS), aria-controls pointing
//     at the panel's id.
//   - The panel has role="menu" and the items have
//     role="menuitem". Each item is a real <a href> (not a
//     div with click handler) so screen readers + middle-click
//     + cmd-click + htmx all work without extra wiring.
//   - aria-current="page" is the caller's responsibility — pass
//     it in triggerAttrs when on the trigger's surface. The
//     primitive never sets it itself.
//
// The panel starts hidden; JS removes the hidden class on
// trigger click. CSS handles the open/close transition (see
// frontend/tailwind.css `.foldout-panel`). The primitive does
// NOT animate — the transition lives in CSS so the same
// pattern can be reused without per-instance JS.
//
// Children render inside the <ul role="menu">. Each child is
// expected to be a single <li role="none"> containing one
// <a role="menuitem" href="...">...</a>. The <li role="none">
// is required by the ARIA menu pattern (the menu role is on
// the <ul>, not the <li>s).
//
// Issue #456 regression note: do NOT delegate this body to
// FoldoutWithBadge via a one-line `@FoldoutWithBadge(...)` call.
// `templ generate` compiles such a delegating wrapper by
// capturing the caller's children into Var1, calling
// `templ.ClearChildren(ctx)`, then rendering the inner
// component — Var1 is never re-injected, so every menuitem
// the caller passes in the children block is silently
// dropped, rendering the panel as `<ul ...></ul>` (visible
// but empty). The body must be inline so codegen writes
// children verbatim, the same shape the pre-#455-slice-1.5
// Foldout had.
templ Foldout(triggerLabel string, menuID string, triggerAttrs templ.Attributes) {
	<div class="foldout relative">
		<button
			type="button"
			class="pill-link top-nav-link inline-flex items-center gap-1"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-controls={ menuID }
			data-foldout-trigger={ menuID }
			{ foldoutAttrsExcludingClass(triggerAttrs)... }
		>
			{ triggerLabel }
			<span aria-hidden="true" class="text-xs">▾</span>
		</button>
		<ul
			id={ menuID }
			role="menu"
			aria-label={ triggerLabel + " menu" }
			data-foldout-panel={ menuID }
			class="foldout-panel absolute right-0 top-full z-50 mt-2 hidden min-w-[14rem] max-w-[calc(100vw-2rem)] flex-col gap-1 rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.96)] p-2 shadow-[0_24px_44px_rgba(23,33,43,0.28)]"
		>
			{ children... }
		</ul>
	</div>
}

// FoldoutWithBadge is the issue #455 slice 1.5 variant of Foldout
// that lets the caller pass an extra templ.Component to render
// inside the trigger button between the label and the ▾ chevron.
// When badge is nil the trigger renders exactly like Foldout, so
// the Share foldout (and any other non-badged consumer) keeps its
// current shape untouched. The badge block's wrapping div carries
// the htmx attributes that drive the live-count poll — the R&R
// foldout polls /layout/review-count via data-layout-research-review-count
// and htmx swaps the count span in place. The polled span stays
// inside the button so it's announced with the trigger label and
// stays visible when the panel is collapsed.
//
// The badge content lives in its own div (instead of a bare span)
// so the JS-side aria-label sync has a stable element to mutate
// without disturbing the wrapping button attributes. See
// layout.templ:134 for the R&R call site.
templ FoldoutWithBadge(triggerLabel string, menuID string, triggerAttrs templ.Attributes, badge templ.Component) {
	<div class="foldout relative">
		<button
			type="button"
			class="pill-link top-nav-link inline-flex items-center gap-1"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-controls={ menuID }
			data-foldout-trigger={ menuID }
			if badge != nil {
				data-foldout-has-badge="1"
			}
			{ foldoutAttrsExcludingClass(triggerAttrs)... }
		>
			{ triggerLabel }
			if badge != nil {
				@badge
			}
			<span aria-hidden="true" class="text-xs">▾</span>
		</button>
		<ul
			id={ menuID }
			role="menu"
			aria-label={ triggerLabel + " menu" }
			data-foldout-panel={ menuID }
			class="foldout-panel absolute right-0 top-full z-50 mt-2 hidden min-w-[14rem] max-w-[calc(100vw-2rem)] flex-col gap-1 rounded-2xl border border-[#8d7440] bg-[rgba(36,48,61,0.96)] p-2 shadow-[0_24px_44px_rgba(23,33,43,0.28)]"
		>
			{ children... }
		</ul>
	</div>
}

// foldoutAttrsExcludingClass strips "class" from the spread attrs
// so the primitive owns the class attribute on the trigger (see
// Field / Pill for the same rationale).
func foldoutAttrsExcludingClass(attrs templ.Attributes) templ.Attributes {
	if attrs == nil {
		return nil
	}
	out := make(templ.Attributes, len(attrs))
	for k, v := range attrs {
		if k == "class" {
			continue
		}
		out[k] = v
	}
	return out
}