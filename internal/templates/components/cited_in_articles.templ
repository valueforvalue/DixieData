// cited_in_articles.templ — "Cited in" reverse-lookup panel
// on the Person Record detail page (issue #321 slice 3.8).
// Renders one row per Article that cites this Person Record
// via the article_refs junction, with a click-through to the
// article detail page.
//
// Hidden when the citedIn slice is empty (the slice-1 detail
// surface stays clean). The component is always rendered by
// the parent templ but conditional on the slice length so
// the JS auto-wire doesn't need to special-case the empty
// state.
package components

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

templ CitedInArticles(personID int64, citedIn []viewmodel.Article) {
	<section class="card mt-6 rounded-3xl p-5 sm:p-8 space-y-4" data-cited-in-articles-panel data-person-id={ fmt.Sprintf("%d", personID) }>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="font-display text-xl font-semibold text-[color:var(--ink)]">Cited in</h2>
			<span class="font-mono text-xs text-slate-500" data-cited-in-count>{ fmt.Sprintf("%d article", len(citedIn)) }</span>
		</div>
		if len(citedIn) == 1 {
			<p class="text-sm text-slate-600" data-cited-in-summary>This Person Record is cited in 1 article.</p>
		} else {
			<p class="text-sm text-slate-600" data-cited-in-summary>{ fmt.Sprintf("This Person Record is cited in %d articles.", len(citedIn)) }</p>
		}
		<ul class="space-y-2" data-cited-in-list>
			for _, article := range citedIn {
				<li class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm" data-cited-in-row data-article-id={ fmt.Sprintf("%d", article.ID) }>
					<div class="flex flex-wrap items-baseline gap-3">
						<a
							href={ templ.SafeURL(routebuilder.ArticleByID(article.ID)) }
							class="font-semibold text-[color:var(--ink)] hover:underline"
							data-cited-in-row-title
						>{ article.Title }</a>
						<span class="font-mono text-xs text-slate-500" data-cited-in-row-display-id>{ article.DisplayID }</span>
						if article.Subtitle != "" {
							<span class="text-xs text-slate-600 truncate max-w-md" data-cited-in-row-subtitle>{ article.Subtitle }</span>
						}
					</div>
					<span class="font-mono text-xs text-slate-400" data-cited-in-row-updated-at>{ article.UpdatedAt }</span>
				</li>
			}
		</ul>
	</section>
}