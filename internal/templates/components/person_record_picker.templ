// person_record_picker.templ — inline Person Record picker
// surface for attaching Person Records to other entities
// (issue #321 slice 3.3, first consumer: Article Records).
//
// Shape: an inline panel with a search input + a results list.
// No native dialog (per docs/agents/dialog-guard.md) and no
// true modal; the picker swaps into a target div via
// hx-get. Each result row is a click-to-attach button that
// posts via `data-action` + `data-method="POST"` to the
// per-entity attach endpoint; the JS dispatcher (app.js)
// follows the `X-DixieData-Redirect` header to navigate back
// to the article detail page so the Refs panel re-renders
// with the new row.
//
// The picker is entity-agnostic at the component layer --
// it just renders the input + results list -- but the
// attach URL is passed in by the caller. The slice-3.3
// Article picker uses /articles/{id}/refs; a future
// picker consumer (e.g. Tags picker on Events) can reuse
// this component by passing a different attach URL.
package components

import (
	"fmt"

	"github.com/valueforvalue/DixieData/internal/routebuilder"
	"github.com/valueforvalue/DixieData/internal/viewmodel"
)

// PersonRecordPickerTrigger renders the "Add Person Record"
// button on the Article Refs panel. Clicking it issues an
// hx-get to /articles/{id}/picker (which renders the picker
// shell fragment) and swaps the response into the picker
// target div on the same page.
templ PersonRecordPickerTrigger(articleID int64) {
	<button
		type="button"
		class="secondary-button"
		hx-get={ templ.SafeURL(routebuilder.ArticlePicker(articleID)) }
		hx-target="[data-person-record-picker-target]"
		hx-swap="innerHTML"
		data-person-record-picker-open
		data-article-id={ fmt.Sprintf("%d", articleID) }
	>Add Person Record</button>
}

// PersonRecordPicker renders the picker shell: search input
// + results list. The input issues an hx-get with the typed
// `q` query so each keystroke (200ms debounce) re-runs the
// search.
//
// Empty state: a guidance message. Click-to-attach on each
// row uses the post-Option-C data-action pattern (no hx-post
// per docs/COMMON_BUGS.md / htmx-guard-lint rule).
templ PersonRecordPicker(articleID int64, q string, results []viewmodel.PersonRecord) {
	<div
		class="space-y-3 rounded-2xl border border-slate-200 bg-white p-4"
		data-person-record-picker
		data-article-id={ fmt.Sprintf("%d", articleID) }
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<label for="person-record-picker-input" class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
				Search Person Records
			</label>
			<button
				type="button"
				class="text-xs text-slate-500 underline"
				data-person-record-picker-close
				onclick="document.querySelector('[data-person-record-picker-target]').innerHTML = ''"
			>Cancel</button>
		</div>
		<input
			type="search"
			id="person-record-picker-input"
			name="q"
			value={ q }
			placeholder="Type a name or display id..."
			class="field-input w-full"
			autocomplete="off"
			hx-get={ templ.SafeURL(routebuilder.ArticlePicker(articleID)) }
			hx-trigger="input changed delay:200ms, search"
			hx-target="closest [data-person-record-picker]"
			hx-swap="outerHTML"
			data-person-record-picker-input
		/>
		if len(results) == 0 {
			<p class="text-sm text-slate-500" data-person-record-picker-empty>
				if q == "" {
					Start typing to search Person Records.
				} else {
					No Person Records match { q }.
				}
			</p>
		} else {
			<ul class="space-y-1" data-person-record-picker-results>
				for _, person := range results {
					<li>
						<form
							action={ templ.SafeURL(routebuilder.ArticleRefsAttach(articleID)) }
							method="post"
							data-dixie-submit="true"
							class="contents"
						>
							<input type="hidden" name="display_id" value={ person.DisplayID }/>
							@Button(
								fmt.Sprintf("%s — %s %s", person.DisplayID, person.FirstName, person.LastName),
								ButtonSecondary,
								"w-full justify-start text-left",
								templ.Attributes{
									"data-person-record-picker-row":         "",
									"data-person-record-picker-display-id":  person.DisplayID,
								},
							)
						</form>
					</li>
				}
			</ul>
		}
	</div>
}