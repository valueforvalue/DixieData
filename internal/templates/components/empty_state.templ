package components

// EmptyState renders the v2 empty-list surface. Existing call sites
// render hand-rolled `<p class="rounded-2xl ...">No results ...</p>`
// markup; the primitive gives every site a single token to swap to.
//
// The `data-empty-state` attribute doubles as a hook for the audit
// harness (`detectVisualIssues` already records empty-state-visible
// findings), so every migration automatically reports in the
// round-3 audit summary.
//
// extraClass accepts the same compound-class pattern as Button /
// Card / Pill / Field so sites that need additional spacing can
// pass it through.
//
// kind picks the visual treatment without callers having to author
// error-specific markup themselves:
//
//	"info"    (default) — neutral slate card, used for empty lists
//	"error"            — red border + warning icon, used when an
//	                     operation failed and the user must see why
//
// Issue #384 / Slice 1: the "error" kind is the visual contract
// every Go respondErrorFragment + JS showToast surfaces fall back to
// when the inline region cannot show a toast (full-page errors,
// modal bodies that lost their toast plumbing, htmx swaps that
// targeted a fragment rather than a toast region).
templ EmptyState(title string, body string, extraClass string) {
	<div
		class={ emptyStateClass(kindInfo, extraClass) }
		data-empty-state="true"
		data-empty-state-kind="info"
	>
		<p class="text-sm font-semibold text-slate-700">{ title }</p>
		<p class="mt-1 text-sm text-slate-500">{ body }</p>
	</div>
}

// EmptyStateError is the error-flavored variant of EmptyState.
// Rendered by appshell.respondErrorFragment when an htmx fragment
// handler's Render call fails, and by any handler that wants the
// fragment body itself to BE the error surface (vs. respondError
// which only sets the X-DixieData-Toast header and writes a plain
// message). The audit probe audit/smoke_swallowed_errors.mjs pins
// the data-empty-state-kind="error" attribute so a future refactor
// that strips the marker fails the regression net.
templ EmptyStateError(title string, body string, extraClass string) {
	<div
		class={ emptyStateClass(kindError, extraClass) }
		data-empty-state="true"
		data-empty-state-kind="error"
		role="alert"
	>
		<p class="text-sm font-semibold text-red-800">
			<span aria-hidden="true" class="mr-1">⚠</span>{ title }
		</p>
		<p class="mt-1 text-sm text-red-700">{ body }</p>
	</div>
}

// kindInfo / kindError are the internal kind labels. Kept private
// because callers should pick by component name (EmptyState vs
// EmptyStateError), not by passing a magic string.
const (
	kindInfo  = "info"
	kindError = "error"
)

// emptyStateClass returns the empty-state class string. The base
// .empty-state class lives in frontend/tailwind.css (added in
// Phase 1.6 alongside this primitive). When kind is "error" we
// append the .empty-state-error modifier so the red border + soft
// red background show without the caller authoring it inline.
func emptyStateClass(kind string, extraClass string) string {
	class := "empty-state"
	if kind == kindError {
		class += " empty-state-error"
	}
	if extraClass != "" {
		class += " " + extraClass
	}
	return class
}