{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": []
  },
  "include": [
    "frontend/**/*.js",
    "frontend/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "audit/node_modules",
    "frontend/eslint-plugin-dixie/**",
    "frontend/wailsjs/**"
  ]
}
